{% doc %}
  A live countdown to the end of a sale. Digits roll as they change and the timer stops at zero.
  Wrap a block in an element with data-hide-when-done to hide it after the sale ends.

  @param {string} end - End date and time, for example 2026-11-30T23:59:00-05:00
  @param {string} [label] - Screen reader label, for example "Black Friday ends in"
  @param {boolean} [show_days] - Show the days unit. Defaults to true
  @param {string} [class] - Extra classes
{% enddoc %}
{%- liquid
  assign count_end = end | date: '%s' | plus: 0
  assign count_now = 'now' | date: '%s' | plus: 0
  assign count_left = count_end | minus: count_now
  if count_left < 0
    assign count_left = 0
  endif
  assign count_d = count_left | divided_by: 86400
  assign count_h = count_left | modulo: 86400 | divided_by: 3600
  assign count_m = count_left | modulo: 3600 | divided_by: 60
  assign count_s = count_left | modulo: 60
  if show_days == false
    assign count_h = count_left | divided_by: 3600
  endif
-%}
<vuffi-countdown
  class="vuffi-count {{ class }}"
  data-end="{{ end | escape }}"
  role="timer"
  aria-label="{{ label | default: 'Sale ends in' | escape }}"
>
  {%- unless show_days == false -%}
    <span class="vuffi-count__unit">
      <span class="vuffi-count__num" data-unit="d">{{ count_d | prepend: '0' | slice: -2, 2 }}</span>
      <span class="vuffi-count__label">d</span>
    </span>
  {%- endunless -%}
  <span class="vuffi-count__unit">
    <span class="vuffi-count__num" data-unit="h">{{ count_h | prepend: '0' | slice: -2, 2 }}</span>
    <span class="vuffi-count__label">h</span>
  </span>
  <span class="vuffi-count__unit">
    <span class="vuffi-count__num" data-unit="m">{{ count_m | prepend: '0' | slice: -2, 2 }}</span>
    <span class="vuffi-count__label">m</span>
  </span>
  <span class="vuffi-count__unit">
    <span class="vuffi-count__num" data-unit="s">{{ count_s | prepend: '0' | slice: -2, 2 }}</span>
    <span class="vuffi-count__label">s</span>
  </span>
</vuffi-countdown>
