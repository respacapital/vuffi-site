{% doc %}
  Vuffi line icons, drawn in code so they stay sharp and follow the section colors.
  The accent detail of each icon takes the section accent (green on light, lime on dark).

  @param {string} name - paw, shield, truck, refresh, tag, vet, cushion, crystal, drop, shell, molecule, heart, clock, check, cross, plus, arrow, star, calendar, scale, chew, bone, spark, lock, box, leaf, joint, smile
  @param {string} [class] - Extra classes
{% enddoc %}
<svg class="vuffi-icon {{ class }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'paw' -%}
      <ellipse cx="9" cy="12.5" rx="2.6" ry="3.4"/><ellipse cx="14" cy="8" rx="2.6" ry="3.4"/><ellipse cx="19.5" cy="8" rx="2.6" ry="3.4"/><ellipse cx="24" cy="12.5" rx="2.6" ry="3.4"/><path class="a" d="M16.5 15c-3.6 0-7.5 5.2-7.5 8.2 0 2.2 1.6 3.3 3.6 3.3 1.6 0 2.4-.8 3.9-.8s2.3.8 3.9.8c2 0 3.6-1.1 3.6-3.3 0-3-3.9-8.2-7.5-8.2Z"/>
    {%- when 'shield' -%}
      <path d="M16 3.5 6 7.5v8c0 6.2 4.2 10.8 10 13 5.8-2.2 10-6.8 10-13v-8l-10-4Z"/><path class="a" d="m11.5 16 3.2 3.2 6-6.4"/>
    {%- when 'truck' -%}
      <path d="M3.5 8.5h15v13h-15zM18.5 13h5.5l4.5 4.5v4h-10"/><circle cx="9" cy="23" r="2.5"/><circle class="a" cx="23" cy="23" r="2.5"/>
    {%- when 'refresh' -%}
      <path d="M26 12a10.5 10.5 0 0 0-18.6-3.2M6 20a10.5 10.5 0 0 0 18.6 3.2"/><path class="a" d="M7 4v5h5M25 28v-5h-5"/>
    {%- when 'tag' -%}
      <path d="M4 16.5V5h11.5L28 17.5 17.5 28 4 16.5Z"/><circle cx="10" cy="10" r="1.6"/><path class="a" d="m13.5 21.5 7-7M14.5 15.5h.01M19.5 20.5h.01"/>
    {%- when 'vet' -%}
      <path d="M8 4v7a6 6 0 0 0 12 0V4"/><path d="M14 17v4a6 6 0 0 0 12 0v-3"/><circle class="a" cx="26" cy="15.5" r="2.5"/><path d="M6 4h4M18 4h4"/>
    {%- when 'cushion' -%}
      <path d="M5 4.5c0 3 2.2 5 5.5 5.5h11c3.3-.5 5.5-2.5 5.5-5.5M5 27.5c0-3 2.2-5 5.5-5.5h11c3.3.5 5.5 2.5 5.5 5.5"/><rect class="a" x="8" y="13" width="16" height="6" rx="3"/>
    {%- when 'crystal' -%}
      <path d="M10 5h12l5 7-11 15L5 12l5-7Z"/><path class="a" d="M5 12h22M13 12l3 15 3-15M10 5l3 7M22 5l-3 7"/>
    {%- when 'drop' -%}
      <path d="M16 3.5S7 13.4 7 19.5a9 9 0 0 0 18 0C25 13.4 16 3.5 16 3.5Z"/><path class="a" d="M11.5 20a4.5 4.5 0 0 0 4.5 4.5"/>
    {%- when 'shell' -%}
      <path d="M16 28C8 24 4.5 16 6 8c4-3 16-3 20 0 1.5 8-2 16-10 20Z"/><path class="a" d="M16 28 11 8.5M16 28l5-19.5M16 28V7"/>
    {%- when 'molecule' -%}
      <path d="m16 5 9.5 5.5v11L16 27l-9.5-5.5v-11L16 5Z"/><circle class="f" cx="16" cy="5" r="2.2"/><circle class="f" cx="25.5" cy="21.5" r="2.2"/><circle class="f" cx="6.5" cy="21.5" r="2.2"/><circle cx="16" cy="16" r="3"/>
    {%- when 'heart' -%}
      <path class="a" d="M16 27s-11-6.7-11-14a6 6 0 0 1 11-3.4A6 6 0 0 1 27 13c0 7.3-11 14-11 14Z"/>
    {%- when 'clock' -%}
      <circle cx="16" cy="16" r="12"/><path class="a" d="M16 9v7l4.5 3"/>
    {%- when 'check' -%}
      <path class="a" d="m7 16.5 6 6L25.5 10"/>
    {%- when 'cross' -%}
      <path d="m9 9 14 14M23 9 9 23"/>
    {%- when 'plus' -%}
      <path d="M16 7v18M7 16h18"/>
    {%- when 'arrow' -%}
      <path d="M6 16h20M19 9l7 7-7 7"/>
    {%- when 'star' -%}
      <path class="a" d="m16 4 3.7 7.6 8.3 1.2-6 5.9 1.4 8.3L16 23.1 8.6 27l1.4-8.3-6-5.9 8.3-1.2L16 4Z"/>
    {%- when 'calendar' -%}
      <rect x="5" y="7" width="22" height="20" rx="3"/><path d="M5 13h22M11 4v6M21 4v6"/><path class="a" d="m12 20 3 3 5.5-5.5"/>
    {%- when 'scale' -%}
      <rect x="5" y="5" width="22" height="22" rx="5"/><path d="M11 12a7 7 0 0 1 10 0"/><path class="a" d="m16 15 2.5-4"/>
    {%- when 'chew' -%}
      <rect x="7" y="9" width="18" height="14" rx="7"/><path class="a" d="M12 14h.01M16 18h.01M20 13.5h.01M14 19.5h.01M19.5 18h.01"/>
    {%- when 'bone' -%}
      <path d="M9.5 6.5a3 3 0 0 0-3 4.5 3 3 0 0 0 4.4 3.3l6.8 6.8a3 3 0 1 0 4.6 3.9 3 3 0 1 0 3.2-4.9 3 3 0 0 0-3.9 1l-6.8-6.8A3 3 0 0 0 9.5 6.5Z"/>
    {%- when 'spark' -%}
      <path class="a" d="M16 4c.8 6.4 5.6 11.2 12 12-6.4.8-11.2 5.6-12 12-.8-6.4-5.6-11.2-12-12 6.4-.8 11.2-5.6 12-12Z"/>
    {%- when 'lock' -%}
      <rect x="6" y="14" width="20" height="14" rx="3"/><path d="M10.5 14V9.5a5.5 5.5 0 0 1 11 0V14"/><path class="a" d="M16 19v4"/>
    {%- when 'box' -%}
      <path d="M4.5 9.5 16 4l11.5 5.5v13L16 28 4.5 22.5v-13Z"/><path d="M4.5 9.5 16 15l11.5-5.5M16 15v13"/><path class="a" d="m10.5 6.8 11.5 5.5"/>
    {%- when 'leaf' -%}
      <path d="M6 26C6 13 13 6 27 5c0 14-7 21-20 21"/><path class="a" d="M6 26 18 14"/>
    {%- when 'joint' -%}
      <path d="M11 3.5v7.5c0 1.6-1.6 2.5-1.6 4.4 0 2.6 2.9 3.6 6.6 3.6s6.6-1 6.6-3.6c0-1.9-1.6-2.8-1.6-4.4V3.5"/><path d="M11 28.5v-4c0-1.2 2-1.6 5-1.6s5 .4 5 1.6v4"/><path class="a" d="M9.5 20.8c2 .9 4.3 1.3 6.5 1.3s4.5-.4 6.5-1.3"/>
    {%- when 'smile' -%}
      <circle cx="16" cy="16" r="12"/><path class="a" d="M11 18.5a6 6 0 0 0 10 0"/><path d="M12 12.5h.01M20 12.5h.01"/>
    {%- else -%}
      <circle class="a" cx="16" cy="16" r="5"/>
  {%- endcase -%}
</svg>
