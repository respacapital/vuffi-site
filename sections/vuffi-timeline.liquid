{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-timeline color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap">
    <div class="vuffi-timeline__top">
      <div class="vuffi-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vuffi-eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="vuffi-h2" data-reveal style="--i: 1">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.note != blank -%}
        <p class="vuffi-small vuffi-timeline__note" data-reveal style="--i: 2">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} The track fills as the section scrolls past, and each step lights up when the fill reaches it {%- endcomment -%}
    <ol class="vuffi-timeline__list" role="list" data-progress style="--count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="vuffi-timeline__step" data-progress-step style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <span class="vuffi-timeline__dot" aria-hidden="true"></span>
          <p class="vuffi-timeline__when">{{ block.settings.when }}</p>
          <h3 class="vuffi-h3 vuffi-timeline__title">{{ block.settings.title }}</h3>
          <div class="vuffi-timeline__text">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .vuffi-timeline__top {
    display: grid;
    gap: 20px;
    margin-bottom: 48px;
  }

  .vuffi-timeline__note {
    margin: 0;
    color: var(--color-foreground-muted);
  }

  .vuffi-timeline__list {
    --progress: 0;
    position: relative;
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0 0 0 44px;
    list-style: none;
  }

  /* The track and its fill */
  .vuffi-timeline__list::before,
  .vuffi-timeline__list::after {
    content: '';
    position: absolute;
    left: 13px;
    top: 28px;
    bottom: 28px;
    width: 2px;
    border-radius: var(--vuffi-radius-btn);
    background: var(--vuffi-line);
  }

  .vuffi-timeline__list::after {
    background: var(--vuffi-accent);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }

  .vuffi-timeline__step {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 24px;
    border-radius: var(--vuffi-radius);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    transition:
      background-color 0.6s var(--vuffi-ease),
      transform 0.6s var(--vuffi-ease);
  }

  .vuffi-timeline__step.is-reached {
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .vuffi-timeline__dot {
    position: absolute;
    z-index: 1;
    left: -44px;
    top: 26px;
    width: 28px;
    height: 28px;
    border: 2px solid var(--vuffi-line-strong);
    border-radius: 50%;
    background: var(--color-background);
    transition:
      border-color 0.4s,
      background-color 0.4s,
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vuffi-timeline__dot::after {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--vuffi-accent);
    transform: scale(0);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__dot {
    border-color: var(--vuffi-accent);
    transform: scale(1.08);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__dot::after {
    transform: scale(1);
  }

  /* The time label is the big moment of each step */
  .vuffi-timeline__when {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.32);
    transition: color 0.6s var(--vuffi-ease);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__when {
    color: var(--vuffi-accent);
  }

  .vuffi-timeline__title {
    margin-top: 4px;
  }

  .vuffi-timeline__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-timeline__text p {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .vuffi-timeline__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
      align-items: end;
      gap: 64px;
      margin-bottom: 64px;
    }

    .vuffi-timeline__list {
      grid-template-columns: repeat(var(--count, 4), minmax(0, 1fr));
      gap: 20px;
      padding: 56px 0 0;
    }

    .vuffi-timeline__list::before,
    .vuffi-timeline__list::after {
      left: 14px;
      right: 14px;
      top: 13px;
      bottom: auto;
      width: auto;
      height: 2px;
    }

    .vuffi-timeline__list::after {
      transform-origin: left;
      transform: scaleX(var(--progress));
    }

    .vuffi-timeline__step {
      padding: 28px;
      min-height: 260px;
      align-content: start;
    }

    .vuffi-timeline__step.is-reached {
      transform: translateY(-6px);
    }

    .vuffi-timeline__dot {
      left: 0;
      top: -56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-timeline__step,
    .vuffi-timeline__dot,
    .vuffi-timeline__dot::after,
    .vuffi-timeline__when {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi timeline",
  "tag": "div",
  "class": "vuffi-timeline-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "What to expect"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Give it <em>90 days.</em>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Every dog is different. Results build with daily use."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "when",
          "label": "When",
          "default": "Week 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A treat they ask for"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>The daily chew becomes the best part of their morning.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi timeline",
      "blocks": [
        { "type": "step", "settings": { "when": "Week 1", "title": "A treat they ask for", "text": "<p>The daily chew becomes the best part of their morning, so the habit sticks from day one.</p>" } },
        { "type": "step", "settings": { "when": "Weeks 2 to 4", "title": "Easier mornings", "text": "<p>Getting up from bed and the first steps of the walk start to look less stiff.</p>" } },
        { "type": "step", "settings": { "when": "Weeks 4 to 8", "title": "More spring", "text": "<p>Stairs, the jump onto the couch and the leap into the car come easier.</p>" } },
        { "type": "step", "settings": { "when": "Day 90", "title": "Moving like themselves", "text": "<p>The full effect of steady daily support. Not happy? Your money back.</p>" } }
      ]
    }
  ]
}
{% endschema %}
