{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-timeline{% if section.settings.glow and tone == 'dark' %} vuffi-glow{% endif %} color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap">
    <div class="vuffi-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vuffi-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.note != blank -%}
        <p class="vuffi-lede vuffi-timeline__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      The track runs from the first circle's center to the last one's (measured by vuffi-motion.js),
      fills as the section scrolls past, and each circle lights up the moment the fill reaches its center.
    {%- endcomment -%}
    <ol class="vuffi-timeline__list" role="list" data-progress="track" style="--count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="vuffi-timeline__step" data-progress-step {{ block.shopify_attributes }}>
          <span class="vuffi-timeline__dot" data-progress-dot aria-hidden="true"></span>
          <div class="vuffi-timeline__card">
            <p class="vuffi-timeline__when">{{ block.settings.when }}</p>
            <h3 class="vuffi-h3 vuffi-timeline__title">{{ block.settings.title }}</h3>
            <div class="vuffi-timeline__text">{{ block.settings.text }}</div>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .vuffi-timeline__note {
    margin: 0;
  }

  /* Phones: the track runs down the left; each circle sits on it, level with its time label */
  .vuffi-timeline__list {
    --progress: 0;
    --dot: 30px;
    --line-a: 0px;
    --line-b: 0px;
    position: relative;
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vuffi-timeline__list::before,
  .vuffi-timeline__list::after {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1px);
    top: var(--line-a);
    width: 2px;
    height: calc(var(--line-b) - var(--line-a));
    border-radius: var(--vuffi-radius-btn);
    background: rgb(var(--color-foreground-rgb) / 0.18);
  }

  .vuffi-timeline__list::after {
    background: var(--vuffi-accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--vuffi-accent) 60%, transparent);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }

  .vuffi-timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--dot) minmax(0, 1fr);
    align-items: start;
    gap: 16px;
  }

  .vuffi-timeline__dot {
    position: relative;
    z-index: 1;
    width: var(--dot);
    height: var(--dot);
    /* Level with the middle of the time label (card padding 22px + half of a 26px label) */
    margin-top: 20px;
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.32);
    border-radius: 50%;
    background: var(--color-background);
    transition:
      border-color 0.4s,
      box-shadow 0.4s;
  }

  .vuffi-timeline__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--vuffi-accent);
    transform: scale(0);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__dot {
    border-color: var(--vuffi-accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--vuffi-accent) 18%, transparent);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__dot::after {
    transform: scale(1);
  }

  .vuffi-timeline__card {
    display: grid;
    gap: 8px;
    padding: 22px 22px 24px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: var(--vuffi-radius-lg);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    transition:
      background-color 0.6s var(--vuffi-ease),
      border-color 0.6s var(--vuffi-ease),
      transform 0.6s var(--vuffi-ease);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__card {
    border-color: color-mix(in srgb, var(--vuffi-accent) 35%, transparent);
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  /* The time label is the big moment of each step */
  .vuffi-timeline__when {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: clamp(26px, 2.2vw, 32px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.36);
    transition: color 0.6s var(--vuffi-ease);
  }

  .vuffi-timeline__step.is-reached .vuffi-timeline__when {
    color: var(--vuffi-accent);
  }

  .vuffi-timeline__title {
    margin-top: 4px;
  }

  .vuffi-timeline__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-timeline__text p {
    margin: 0;
  }

  /* Computers: the track runs across the top, each circle centered over its card */
  @media screen and (min-width: 990px) {
    .vuffi-timeline__list {
      --dot: 32px;
      grid-template-columns: repeat(var(--count, 4), minmax(0, 1fr));
      gap: 20px;
    }

    .vuffi-timeline__list::before,
    .vuffi-timeline__list::after {
      left: var(--line-a);
      top: calc(var(--dot) / 2 - 1px);
      width: calc(var(--line-b) - var(--line-a));
      height: 2px;
    }

    .vuffi-timeline__list::after {
      transform-origin: left;
      transform: scaleX(var(--progress));
    }

    .vuffi-timeline__step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      justify-items: center;
      gap: 28px;
    }

    .vuffi-timeline__dot {
      margin-top: 0;
    }

    .vuffi-timeline__card {
      justify-self: stretch;
      align-self: stretch;
      align-content: start;
      padding: 28px;
      text-align: center;
    }

    .vuffi-timeline__step.is-reached .vuffi-timeline__card {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-timeline__card,
    .vuffi-timeline__dot,
    .vuffi-timeline__dot::after,
    .vuffi-timeline__when {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi timeline",
  "tag": "div",
  "class": "vuffi-timeline-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Give it <em>90 days.</em>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Every dog is different. Results build with daily use."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Soft light behind, like the hero",
      "default": true,
      "info": "Shows on dark and green backgrounds."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "when",
          "label": "When",
          "default": "Week 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A treat they ask for"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>The daily chew becomes the best part of their morning.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi timeline",
      "blocks": [
        { "type": "step", "settings": { "when": "Week 1", "title": "A treat they ask for", "text": "<p>The daily chew becomes the best part of their morning, so the habit sticks from day one.</p>" } },
        { "type": "step", "settings": { "when": "Weeks 2 to 4", "title": "Easier mornings", "text": "<p>Getting up from bed and the first steps of the walk start to look less stiff.</p>" } },
        { "type": "step", "settings": { "when": "Weeks 4 to 8", "title": "More spring", "text": "<p>Stairs, the jump onto the couch and the leap into the car come easier.</p>" } },
        { "type": "step", "settings": { "when": "Day 90", "title": "Moving like themselves", "text": "<p>The full effect of steady daily support. Not happy? Your money back.</p>" } }
      ]
    }
  ]
}
{% endschema %}
