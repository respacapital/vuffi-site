{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}
<script src="{{ 'vuffi-joint.js' | asset_url }}" defer></script>

<section class="vuffi-section vuffi-joint color-custom-{{ section.id }}" data-tone="{{ tone }}" id="how-it-works">
  <vuffi-joint class="vuffi-wrap vuffi-joint__grid" data-state="worn">
    <div class="vuffi-joint__copy">
      <div class="vuffi-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vuffi-eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="vuffi-h2" data-reveal style="--i: 1">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="vuffi-lede" data-reveal style="--i: 2">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="vuffi-joint__toggle" role="group" aria-label="{{ section.settings.toggle_label | escape }}" data-reveal style="--i: 3">
        <button type="button" class="vuffi-joint__switch" data-set="worn" aria-pressed="true">
          {{- section.settings.worn_label -}}
        </button>
        <button type="button" class="vuffi-joint__switch" data-set="supported" aria-pressed="false">
          {{- section.settings.supported_label -}}
        </button>
        <span class="vuffi-joint__thumb" aria-hidden="true"></span>
      </div>

      <ol class="vuffi-joint__list" role="list">
        {%- for block in section.blocks -%}
          <li class="vuffi-joint__item" data-reveal style="--i: {{ forloop.index | plus: 3 }}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="vuffi-joint__ing"
              data-mark="{{ block.id }}"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="JointText-{{ block.id }}"
            >
              <span class="vuffi-joint__n vuffi-num">{{ forloop.index }}</span>
              <span class="vuffi-joint__name">{{ block.settings.name }}</span>
              <span class="vuffi-joint__role">{{ block.settings.role }}</span>
            </button>
            <div class="vuffi-joint__text" id="JointText-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {{ block.settings.text }}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>

    <div class="vuffi-joint__visual" data-reveal="scale">
      <span class="vuffi-joint__scan" aria-hidden="true"></span>
      <div class="vuffi-joint__layer vuffi-joint__layer--worn">
        {%- render 'vuffi-image',
          image: section.settings.worn_image,
          label: 'diagram-joint-worn',
          ratio: '1 / 1',
          size: '1600 x 1600',
          sizes: '(min-width: 990px) 46vw, 92vw'
        -%}
      </div>
      <div class="vuffi-joint__layer vuffi-joint__layer--supported">
        {%- render 'vuffi-image',
          image: section.settings.supported_image,
          label: 'diagram-joint-ingredients',
          ratio: '1 / 1',
          size: '1600 x 1600',
          sizes: '(min-width: 990px) 46vw, 92vw'
        -%}
        <ol class="vuffi-joint__marks" role="list" aria-hidden="true">
          {%- for block in section.blocks -%}
            <li
              class="vuffi-joint__mark vuffi-num"
              data-mark="{{ block.id }}"
              style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --n: {{ forloop.index0 }};"
            >
              {{- forloop.index -}}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </vuffi-joint>
</section>

{% stylesheet %}
  .vuffi-joint__grid {
    display: grid;
    gap: 28px;
  }

  .vuffi-joint__copy {
    display: contents;
  }

  .vuffi-joint__copy > .vuffi-head {
    order: 1;
  }

  .vuffi-joint__visual {
    order: 2;
  }

  .vuffi-joint__toggle {
    order: 3;
  }

  .vuffi-joint__list {
    order: 4;
  }

  .vuffi-joint__toggle {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    justify-self: start;
    padding: 4px;
    border: 1px solid var(--vuffi-line);
    border-radius: var(--vuffi-radius-btn);
    background: var(--vuffi-soft);
  }

  .vuffi-joint__switch {
    position: relative;
    z-index: 1;
    min-height: 44px;
    padding: 0 22px;
    border: 0;
    border-radius: var(--vuffi-radius-btn);
    background: none;
    color: inherit;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.4s var(--vuffi-ease);
  }

  .vuffi-joint__switch[aria-pressed='true'] {
    color: var(--color-background);
  }

  .vuffi-joint__thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    border-radius: var(--vuffi-radius-btn);
    background: var(--color-foreground);
    transition: transform 0.55s var(--vuffi-ease), background-color 0.4s;
  }

  [data-state='supported'] .vuffi-joint__thumb {
    transform: translateX(100%);
    background: var(--vuffi-accent);
  }

  .vuffi-joint__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--vuffi-line);
  }

  .vuffi-joint__item {
    border-bottom: 1px solid var(--vuffi-line);
  }

  .vuffi-joint__ing {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 18px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .vuffi-joint__n {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--vuffi-line-strong);
    border-radius: 50%;
    font-size: 13px;
    font-weight: 600;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .vuffi-joint__name {
    font-size: 18px;
    font-weight: 600;
  }

  .vuffi-joint__role {
    font-size: 14px;
    color: var(--color-foreground-muted);
  }

  .vuffi-joint__ing[aria-expanded='true'] .vuffi-joint__n {
    background: var(--vuffi-accent);
    border-color: var(--vuffi-accent);
    color: var(--color-background);
  }

  .vuffi-joint__text {
    padding: 0 0 20px 46px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-joint__text p {
    margin: 0;
  }

  /* No box: the white diagram sits straight on the white section */
  .vuffi-joint__visual {
    position: relative;
    display: grid;
    background: #ffffff;
    overflow: hidden;
  }

  /* Switching wipes the supported joint across the worn one behind a leaf green scan line */
  .vuffi-joint__layer {
    position: relative;
    grid-area: 1 / 1;
  }

  .vuffi-joint__layer--supported {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  [data-state='worn'] .vuffi-joint__layer--supported {
    clip-path: inset(0 100% 0 0);
  }

  .vuffi-joint__scan {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    margin-left: -1px;
    background: var(--vuffi-lime);
    box-shadow: 0 0 18px 4px color-mix(in srgb, var(--vuffi-lime) 60%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  [data-state='supported'] .vuffi-joint__scan {
    animation: vuffi-scan-in 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  [data-state='worn'].is-switched .vuffi-joint__scan {
    animation: vuffi-scan-out 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  @keyframes vuffi-scan-in {
    0% { left: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  @keyframes vuffi-scan-out {
    0% { left: 100%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { left: 0; opacity: 0; }
  }

  /* Numbers pop in one after another when the supported joint shows */
  [data-state='worn'] .vuffi-joint__mark {
    opacity: 0;
    scale: 0.3;
  }

  .vuffi-joint__layer .vuffi-media {
    border-radius: 0;
    background: #ffffff;
  }


  .vuffi-joint__marks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Numbered markers sit on the empty circles in the supported joint image */
  .vuffi-joint__mark {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    place-items: center;
    width: max(28px, 7.4%);
    aspect-ratio: 1;
    border: 2px solid var(--vuffi-ink);
    border-radius: 50%;
    background: #ffffff;
    color: var(--vuffi-ink);
    font-size: clamp(13px, 1.3vw, 17px);
    font-weight: 700;
    line-height: 1;
    transform: translate(-50%, -50%);
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--vuffi-ease),
      opacity 0.4s var(--vuffi-ease) calc(0.3s + var(--n, 0) * 0.08s),
      scale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.3s + var(--n, 0) * 0.08s);
  }

  .vuffi-joint__mark.is-active {
    border-color: var(--vuffi-lime);
    background: var(--vuffi-ink);
    color: var(--vuffi-lime);
    transform: translate(-50%, -50%) scale(1.15);
  }

  @media screen and (min-width: 990px) {
    .vuffi-joint__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: start;
      gap: 72px;
    }

    .vuffi-joint__copy {
      display: grid;
      gap: 32px;
      align-content: start;
    }

    .vuffi-joint__visual {
      position: sticky;
      top: 100px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-joint__layer,
    .vuffi-joint__mark,
    .vuffi-joint__thumb {
      transition: none;
    }

    .vuffi-joint__scan {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi joint diagram",
  "tag": "div",
  "class": "vuffi-joint-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Two joint images that switch from worn to supported as the section scrolls into view. Visitors can flip between them and tap each ingredient to light up its number on the supported image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "How it works"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "What happens <em>inside</em> the joint."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Cartilage cushions the ends of the bones and joint fluid keeps them gliding. Age, weight and years of play wear both down. Vuffi gives the joint what it needs to rebuild, protect and calm.</p>"
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Switch name for screen readers",
      "default": "Show the joint"
    },
    {
      "type": "text",
      "id": "worn_label",
      "label": "Worn button",
      "default": "Worn joint"
    },
    {
      "type": "text",
      "id": "supported_label",
      "label": "Supported button",
      "default": "Supported joint"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "worn_image",
      "label": "Worn joint",
      "info": "Square. Shows first, before the switch."
    },
    {
      "type": "image_picker",
      "id": "supported_image",
      "label": "Supported joint",
      "info": "Square, with an empty circle for each ingredient. Set each ingredient's number position in its block."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Glucosamine"
        },
        {
          "type": "text",
          "id": "role",
          "label": "What it does, in a few words",
          "default": "Rebuilds cartilage"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "More detail",
          "default": "<p>The raw material your dog's body uses to build and repair the cushion on the ends of the bones.</p>"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Number position across",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "info": "From the left edge of the supported joint image."
        },
        {
          "type": "range",
          "id": "y",
          "label": "Number position down",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "info": "From the top edge."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi joint diagram",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Glucosamine",
            "role": "Rebuilds cartilage",
            "x": 38,
            "y": 42,
            "text": "<p>The raw material your dog's body uses to build and repair the cushion on the ends of the bones. Dogs make less of it as they age.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Chondroitin",
            "role": "Keeps it springy",
            "x": 43,
            "y": 64,
            "text": "<p>Pulls water into cartilage so it absorbs every landing, and slows the enzymes that wear it away.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "MSM",
            "role": "Calms swelling",
            "x": 77,
            "y": 45,
            "text": "<p>A natural sulfur compound the body uses for cartilage, tendons and ligaments. It helps calm swelling inside sore joints.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Hyaluronic acid",
            "role": "Keeps joints gliding",
            "x": 48,
            "y": 55,
            "text": "<p>The main ingredient of joint fluid, the slick cushion that lets bones glide. Older and injured joints run low on it.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Green lipped mussel",
            "role": "Cools inflammation",
            "x": 79,
            "y": 66,
            "text": "<p>A New Zealand shellfish rich in omega fats that turn down inflammation, plus natural cartilage building blocks.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
