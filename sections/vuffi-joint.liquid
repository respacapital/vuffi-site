{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}
<script src="{{ 'vuffi-joint.js' | asset_url }}" defer></script>

<section class="vuffi-section vuffi-joint{% if section.settings.glow and tone == 'dark' %} vuffi-glow{% endif %} color-custom-{{ section.id }}" data-tone="{{ tone }}" id="how-it-works">
  <vuffi-joint class="vuffi-wrap" data-state="worn" style="--joint-card: {{ section.settings.card_color | default: '#ffffff' }};">
    <div class="vuffi-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vuffi-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="vuffi-joint__stage">
      <div class="vuffi-joint__visual">
        <div class="vuffi-joint__layer vuffi-joint__layer--worn">
          {%- render 'vuffi-image',
            image: section.settings.worn_image,
            label: 'diagram-joint-worn',
            ratio: '1 / 1',
            size: '1600 x 1600',
            sizes: '(min-width: 990px) 600px, 92vw'
          -%}
        </div>
        <div class="vuffi-joint__layer vuffi-joint__layer--supported">
          {%- render 'vuffi-image',
            image: section.settings.supported_image,
            label: 'diagram-joint-ingredients',
            ratio: '1 / 1',
            size: '1600 x 1600',
            sizes: '(min-width: 990px) 600px, 92vw'
          -%}
          <ol class="vuffi-joint__marks" role="list" aria-hidden="true">
            {%- for block in section.blocks -%}
              <li
                class="vuffi-joint__mark vuffi-num"
                data-mark="{{ block.id }}"
                style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --n: {{ forloop.index0 }};"
              >
                <span>{{ forloop.index }}</span>
              </li>
            {%- endfor -%}
          </ol>
        </div>

        <div class="vuffi-joint__toggle" role="group" aria-label="{{ section.settings.toggle_label | escape }}">
          <button type="button" class="vuffi-joint__switch" data-set="worn" aria-pressed="true">
            {{- section.settings.worn_label -}}
          </button>
          <button type="button" class="vuffi-joint__switch" data-set="supported" aria-pressed="false">
            {{- section.settings.supported_label -}}
          </button>
          <span class="vuffi-joint__thumb" aria-hidden="true"></span>
        </div>
      </div>

      <ol class="vuffi-joint__list" role="list">
        {%- for block in section.blocks -%}
          <li class="vuffi-joint__item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="vuffi-joint__ing"
              data-mark="{{ block.id }}"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="JointText-{{ block.id }}"
            >
              <span class="vuffi-joint__n vuffi-num" aria-hidden="true"><span>{{ forloop.index }}</span></span>
              <span class="vuffi-joint__names">
                <span class="vuffi-joint__name">{{ block.settings.name }}</span>
                <span class="vuffi-joint__role">{{ block.settings.role }}</span>
              </span>
              <span class="vuffi-joint__chev" aria-hidden="true"></span>
            </button>
            <div class="vuffi-joint__text" id="JointText-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {{ block.settings.text }}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </vuffi-joint>
</section>

{% stylesheet %}
  vuffi-joint {
    display: block;
  }

  /* The diagram sits on a lit card; the ingredients sit beside it on computers and under it on phones */
  .vuffi-joint__stage {
    display: grid;
    gap: 28px;
  }

  .vuffi-joint__visual {
    position: relative;
    display: grid;
    overflow: hidden;
    background: transparent;
  }

  .vuffi-joint__layer {
    position: relative;
    grid-area: 1 / 1;
  }

  /* The joint photos fade out softly at every edge, so they melt into the section instead of sitting in a box */
  .vuffi-joint__layer .vuffi-media {
    border-radius: 0;
    background: transparent;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%);
  }

  /* A plain crossfade between the two joints */
  .vuffi-joint__layer--supported {
    opacity: 1;
    transition: opacity 0.7s var(--vuffi-ease);
  }

  [data-state='worn'] .vuffi-joint__layer--supported {
    opacity: 0;
  }

  /* Worn or supported switch, floating on the bottom of the card */
  .vuffi-joint__toggle {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: max-content;
    padding: 4px;
    border-radius: var(--vuffi-radius-btn);
    background: var(--vuffi-ink);
    box-shadow: 0 12px 30px rgb(11 20 16 / 0.28);
    transform: translateX(-50%);
  }

  .vuffi-joint__switch {
    position: relative;
    z-index: 1;
    min-height: 42px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--vuffi-radius-btn);
    background: none;
    color: #ffffff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.4s var(--vuffi-ease);
  }

  .vuffi-joint__switch[aria-pressed='true'] {
    color: var(--vuffi-ink);
  }

  .vuffi-joint__switch:focus-visible {
    outline: 2px solid var(--vuffi-lime);
    outline-offset: 2px;
  }

  .vuffi-joint__thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    border-radius: var(--vuffi-radius-btn);
    background: #ffffff;
    transition: transform 0.55s var(--vuffi-ease), background-color 0.4s;
  }

  [data-state='supported'] .vuffi-joint__thumb {
    transform: translateX(100%);
    background: var(--vuffi-lime);
  }

  /* Numbered markers sit exactly on the empty circles in the supported joint image */
  .vuffi-joint__marks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vuffi-joint__mark {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    justify-content: center;
    width: max(26px, 5.6%);
    aspect-ratio: 1;
    border: 2px solid var(--vuffi-ink);
    border-radius: 50%;
    background: #ffffff;
    color: var(--vuffi-ink);
    font-family: var(--font-heading--family);
    font-size: clamp(12px, 1.15vw, 16px);
    font-weight: 700;
    line-height: 1;
    transform: translate(-50%, -50%);
    transition:
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.3s,
      opacity 0.4s var(--vuffi-ease) calc(0.25s + var(--n, 0) * 0.08s);
  }

  [data-state='worn'] .vuffi-joint__mark {
    opacity: 0;
  }

  .vuffi-joint__mark.is-active {
    background: var(--vuffi-lime);
    box-shadow: 0 0 0 5px rgb(198 227 90 / 0.35);
  }

  /* Digits trimmed to their cap height so they sit dead center in every circle */
  .vuffi-joint__mark > span,
  .vuffi-joint__n > span {
    display: block;
    text-box: trim-both cap alphabetic;
  }

  /* Ingredient list: hairline rows, like the index on a clinical chart */
  .vuffi-joint__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: center;
    border-top: 1px solid var(--vuffi-line);
  }

  .vuffi-joint__item {
    border-bottom: 1px solid var(--vuffi-line);
  }

  .vuffi-joint__ing {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 20px 4px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .vuffi-joint__ing:focus-visible {
    outline: 2px solid var(--vuffi-accent);
    outline-offset: -2px;
  }

  .vuffi-joint__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--vuffi-line-strong);
    border-radius: 50%;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .vuffi-joint__ing[aria-expanded='true'] .vuffi-joint__n {
    background: var(--vuffi-accent);
    border-color: var(--vuffi-accent);
    color: var(--color-background);
  }

  .vuffi-joint__names {
    display: grid;
    gap: 3px;
  }

  .vuffi-joint__name {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .vuffi-joint__role {
    font-size: 14px;
    line-height: 1.35;
    color: var(--color-foreground-muted);
  }

  .vuffi-joint__chev {
    width: 10px;
    height: 10px;
    justify-self: center;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    opacity: 0.5;
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.35s var(--vuffi-ease);
  }

  .vuffi-joint__ing[aria-expanded='true'] .vuffi-joint__chev {
    transform: translateY(2px) rotate(-135deg);
  }

  .vuffi-joint__text {
    padding: 0 8px 24px 60px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-joint__text p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .vuffi-joint__switch {
      min-height: 46px;
      padding: 0 24px;
      font-size: 15px;
    }

    .vuffi-joint__toggle {
      bottom: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    .vuffi-joint__stage {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-joint__layer--supported,
    .vuffi-joint__mark,
    .vuffi-joint__thumb,
    .vuffi-joint__chev {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi joint diagram",
  "tag": "div",
  "class": "vuffi-joint-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Two joint images that switch from worn to supported as the section scrolls into view. Visitors can flip between them and tap each ingredient to light up its number on the supported image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "What happens <em>inside</em> the joint."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Cartilage cushions the ends of the bones and joint fluid keeps them gliding. Age, weight and years of play wear both down. Vuffi gives the joint what it needs to rebuild, protect and calm.</p>"
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Switch name for screen readers",
      "default": "Show the joint"
    },
    {
      "type": "text",
      "id": "worn_label",
      "label": "Worn button",
      "default": "Worn joint"
    },
    {
      "type": "text",
      "id": "supported_label",
      "label": "Supported button",
      "default": "Supported joint"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "worn_image",
      "label": "Worn joint",
      "info": "Square. Shows first, before the switch."
    },
    {
      "type": "image_picker",
      "id": "supported_image",
      "label": "Supported joint",
      "info": "Square, with an empty circle for each ingredient. Set each ingredient's number position in its block."
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card behind the joint images",
      "default": "#FFFFFF",
      "info": "Match this to the background of the joint images."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Soft natural light on dark backgrounds",
      "default": true,
      "info": "A faint warm light from the top corner, like the hero photo. It never moves."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Glucosamine"
        },
        {
          "type": "text",
          "id": "role",
          "label": "What it does, in a few words",
          "default": "Rebuilds cartilage"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "More detail",
          "default": "<p>The raw material your dog's body uses to build and repair the cushion on the ends of the bones.</p>"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Number position across",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "info": "From the left edge of the supported joint image."
        },
        {
          "type": "range",
          "id": "y",
          "label": "Number position down",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "info": "From the top edge."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi joint diagram",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Glucosamine",
            "role": "Rebuilds cartilage",
            "x": 38,
            "y": 42,
            "text": "<p>The raw material your dog's body uses to build and repair the cushion on the ends of the bones. Dogs make less of it as they age.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Chondroitin",
            "role": "Keeps it springy",
            "x": 43,
            "y": 64,
            "text": "<p>Pulls water into cartilage so it absorbs every landing, and slows the enzymes that wear it away.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "MSM",
            "role": "Calms swelling",
            "x": 77,
            "y": 45,
            "text": "<p>A natural sulfur compound the body uses for cartilage, tendons and ligaments. It helps calm swelling inside sore joints.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Hyaluronic acid",
            "role": "Keeps joints gliding",
            "x": 48,
            "y": 55,
            "text": "<p>The main ingredient of joint fluid, the slick cushion that lets bones glide. Older and injured joints run low on it.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Green lipped mussel",
            "role": "Cools inflammation",
            "x": 79,
            "y": 66,
            "text": "<p>A New Zealand shellfish rich in omega fats that turn down inflammation, plus natural cartilage building blocks.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
