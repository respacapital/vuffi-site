{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
  assign start = section.settings.start_weight
  assign span = section.settings.max_weight | minus: 5
  assign fill = start | minus: 5 | times: 100.0 | divided_by: span
  assign tiers = section.blocks | where: 'type', 'tier'
  assign tips = section.blocks | where: 'type', 'tip'
  assign first = tiers.first
-%}
{%- render 'vuffi-section-style', section: section -%}
<script src="{{ 'vuffi-dose.js' | asset_url }}" defer></script>

{%- comment -%}
  How to give it: slide to your dog's weight and the dose, how long one jar lasts and what to order for a month update.
  Left: headline, text and a few habits on hairlines. Right: the slider and the answer rows.
{%- endcomment -%}
<section class="vuffi-section vuffi-dose{% if section.settings.glow and tone == 'dark' %} vuffi-glow{% endif %} color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap">
    <div class="vuffi-intro">
      <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <vuffi-dose class="vuffi-dose__finder" data-over="{{ section.settings.over_weight }}">
      <script type="application/json" data-tiers>
        [
          {%- for block in tiers -%}
            {"upTo": {{ block.settings.up_to }}, "chews": {{ block.settings.chews }}, "amount": {{ block.settings.amount | json }}, "lasts": {{ block.settings.lasts | json }}, "order": {{ block.settings.order | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>

      <div class="vuffi-dose__input">
        <label class="vuffi-dose__label" for="DoseWeight-{{ section.id }}">{{ section.settings.slider_label }}</label>
        <output class="vuffi-dose__weight vuffi-num" for="DoseWeight-{{ section.id }}">
          <span data-weight>{{ start }}</span>
          <span class="vuffi-dose__unit">lbs</span>
        </output>
        <input
          class="vuffi-dose__range"
          type="range"
          id="DoseWeight-{{ section.id }}"
          min="5"
          max="{{ section.settings.max_weight }}"
          step="1"
          value="{{ start }}"
          aria-valuetext="{{ start }} pounds"
          style="--fill: {{ fill }}%;"
        >
        <div class="vuffi-dose__ticks vuffi-num" aria-hidden="true">
          <span>5</span>
          {%- for block in tiers -%}
            {%- assign at = block.settings.up_to | minus: 5 | times: 100.0 | divided_by: span -%}
            <span style="--at: {{ at }}%;">{{ block.settings.up_to }}</span>
          {%- endfor -%}
          <span>{{ section.settings.max_weight }}+</span>
        </div>
      </div>

      <div class="vuffi-dose__answer" aria-live="polite">
        <dl class="vuffi-dose__rows" data-rows>
          <div class="vuffi-dose__row">
            <dt>{{ section.settings.label_amount }}</dt>
            <dd>
              <span class="vuffi-dose__chews" data-chews aria-hidden="true">
                {%- for i in (1..4) -%}
                  <span class="vuffi-dose__chew"{% if forloop.index > first.settings.chews %} hidden{% endif %}></span>
                {%- endfor -%}
              </span>
              <span data-amount>{{ first.settings.amount }}</span>
            </dd>
          </div>
          <div class="vuffi-dose__row">
            <dt>{{ section.settings.label_lasts }}</dt>
            <dd class="vuffi-num" data-lasts>{{ first.settings.lasts }}</dd>
          </div>
          <div class="vuffi-dose__row">
            <dt>{{ section.settings.label_order }}</dt>
            <dd data-order>{{ first.settings.order }}</dd>
          </div>
        </dl>
        <p class="vuffi-dose__over" data-over-copy hidden>{{ section.settings.over_text }}</p>
      </div>
    </vuffi-dose>

    {%- if tips.size > 0 -%}
      <ul class="vuffi-dose__tips" role="list" style="--tips: {{ tips.size }};">
        {%- for block in tips -%}
          <li class="vuffi-dose__tip" {{ block.shopify_attributes }}>
            <h3 class="vuffi-dose__tip-title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="vuffi-dose__tip-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="vuffi-small vuffi-dose__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Centered like the other sections: headline, then the finder in one calm column, then the habits */
  .vuffi-dose__finder {
    display: grid;
    gap: 28px;
    max-width: 640px;
    margin: 0 auto;
  }

  .vuffi-dose__input {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }

  .vuffi-dose__label {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-foreground-muted);
  }

  .vuffi-dose__weight {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(80px, 10vw, 136px);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .vuffi-dose__unit {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: 0;
    color: var(--color-foreground-muted);
  }

  /* Slider: pill track that fills with the accent color and a round thumb, like the buy box options */
  .vuffi-dose__range {
    --fill: 40%;
    width: 100%;
    height: 36px;
    margin: 14px 0 0;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    touch-action: pan-y;
  }

  .vuffi-dose__range::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--vuffi-accent) var(--fill), var(--vuffi-line) var(--fill));
  }

  .vuffi-dose__range::-moz-range-track {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--vuffi-accent) var(--fill), var(--vuffi-line) var(--fill));
  }

  .vuffi-dose__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 32px;
    height: 32px;
    margin-top: -12px;
    border: 4px solid var(--color-background);
    border-radius: 50%;
    background: var(--vuffi-accent);
    box-shadow: 0 0 0 1px var(--vuffi-line-strong), 0 8px 20px rgb(11 20 17 / 0.2);
  }

  .vuffi-dose__range::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border: 4px solid var(--color-background);
    border-radius: 50%;
    background: var(--vuffi-accent);
    box-shadow: 0 0 0 1px var(--vuffi-line-strong), 0 8px 20px rgb(11 20 17 / 0.2);
  }

  .vuffi-dose__range:focus-visible {
    outline: 2px solid var(--vuffi-accent);
    outline-offset: 6px;
    border-radius: 999px;
  }

  .vuffi-dose__ticks {
    position: relative;
    width: 100%;
    height: 18px;
    font-size: 13px;
    color: var(--color-foreground-muted);
  }

  .vuffi-dose__ticks span {
    position: absolute;
    top: 0;
    left: var(--at, 0%);
    transform: translateX(-50%);
  }

  .vuffi-dose__ticks span:first-child {
    left: 0;
    transform: none;
  }

  .vuffi-dose__ticks span:last-child {
    left: auto;
    right: 0;
    transform: none;
  }

  /* The answer: three rows on a rounded card, like the buy box */
  .vuffi-dose__answer {
    border: 1px solid var(--vuffi-line);
    border-radius: var(--vuffi-radius-ui, 18px);
    background: var(--vuffi-card, rgb(var(--color-foreground-rgb) / 0.03));
    overflow: hidden;
  }

  .vuffi-dose__rows {
    margin: 0;
  }

  .vuffi-dose__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    padding: 14px 22px;
  }

  .vuffi-dose__row + .vuffi-dose__row {
    border-top: 1px solid var(--vuffi-line);
  }

  .vuffi-dose__row dt {
    font-size: 15px;
    color: var(--color-foreground-muted);
  }

  .vuffi-dose__row dd {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-align: right;
  }

  /* A small drawn chew per chew a day */
  .vuffi-dose__chews {
    display: flex;
    gap: 4px;
  }

  .vuffi-dose__chew {
    width: 20px;
    height: 15px;
    border-radius: 5px / 4px;
    background: linear-gradient(180deg, #8a5d42 0 30%, #62402b 30% 100%);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.18);
  }

  .vuffi-dose__chew[hidden] {
    display: none;
  }

  .vuffi-dose__over {
    margin: 0;
    padding: 22px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(19px, 1.8vw, 24px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-align: center;
  }

  .vuffi-dose__over[hidden],
  .vuffi-dose__rows[hidden] {
    display: none;
  }

  .vuffi-dose__answer.is-swap dd {
    animation: vuffi-dose-swap 0.35s var(--vuffi-ease);
  }

  @keyframes vuffi-dose-swap {
    from {
      opacity: 0.2;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-dose__answer.is-swap dd {
      animation: none;
    }
  }

  .vuffi-dose__tips {
    display: grid;
    gap: 0;
    max-width: 1100px;
    margin: 64px auto 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--vuffi-line);
  }

  .vuffi-dose__tip {
    display: grid;
    gap: 6px;
    padding: 20px 0 22px;
    border-bottom: 1px solid var(--vuffi-line);
  }

  .vuffi-dose__tip-title {
    margin: 0;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 600;
  }

  .vuffi-dose__tip-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-foreground-muted);
  }

  .vuffi-dose__note {
    max-width: 640px;
    margin: 28px auto 0;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .vuffi-dose__tips {
      grid-template-columns: repeat(var(--tips, 3), minmax(0, 1fr));
      column-gap: 48px;
      margin-top: 88px;
    }

    .vuffi-dose__tip {
      border-bottom: 0;
      padding-top: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi how to give it",
  "tag": "div",
  "class": "vuffi-dose-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "How to <em>give it.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Slide to your dog's weight to see how many chews a day, how long one jar lasts and what to order for a full month.</p>"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "text",
      "id": "slider_label",
      "label": "Slider label",
      "default": "Your dog's weight"
    },
    {
      "type": "range",
      "id": "start_weight",
      "label": "Starting weight",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "lb",
      "default": 30
    },
    {
      "type": "range",
      "id": "max_weight",
      "label": "Highest weight on the slider",
      "min": 70,
      "max": 120,
      "step": 5,
      "unit": "lb",
      "default": 80
    },
    {
      "type": "range",
      "id": "over_weight",
      "label": "Ask your vet from",
      "min": 40,
      "max": 120,
      "step": 1,
      "unit": "lb",
      "default": 66
    },
    {
      "type": "text",
      "id": "over_text",
      "label": "Text for heavier dogs",
      "default": "This jar is made for dogs up to 65 lbs. Ask your vet for the right amount."
    },
    {
      "type": "header",
      "content": "Answer rows"
    },
    {
      "type": "text",
      "id": "label_amount",
      "label": "Amount row",
      "default": "Each day"
    },
    {
      "type": "text",
      "id": "label_lasts",
      "label": "Jar row",
      "default": "One jar lasts"
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Order row",
      "default": "For a full month"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "For dogs over 12 weeks old. Contains shellfish (green lipped mussel)."
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Soft natural light on dark backgrounds",
      "default": true,
      "info": "A faint warm light from the top corner, like the hero photo. It never moves."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Weight band",
      "settings": [
        {
          "type": "range",
          "id": "up_to",
          "label": "Up to",
          "min": 10,
          "max": 110,
          "step": 1,
          "unit": "lb",
          "default": 35
        },
        {
          "type": "range",
          "id": "chews",
          "label": "Chews a day (icons)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Amount",
          "default": "1 chew"
        },
        {
          "type": "text",
          "id": "lasts",
          "label": "One jar lasts",
          "default": "30 days"
        },
        {
          "type": "text",
          "id": "order",
          "label": "For a full month",
          "default": "1 jar"
        }
      ]
    },
    {
      "type": "tip",
      "name": "Habit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "With a meal"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi how to give it",
      "blocks": [
        { "type": "tier", "settings": { "up_to": 35, "chews": 1, "amount": "1 chew", "lasts": "30 days", "order": "1 jar" } },
        { "type": "tier", "settings": { "up_to": 65, "chews": 2, "amount": "2 chews", "lasts": "15 days", "order": "2 jars" } },
        { "type": "tip", "settings": { "title": "With a meal" } },
        { "type": "tip", "settings": { "title": "Every day, no gaps" } },
        { "type": "tip", "settings": { "title": "Judge it at 90 days" } }
      ]
    }
  ]
}
{% endschema %}
