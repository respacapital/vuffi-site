{% comment %}
  Loads the Vuffi styles and motion script once on every page.
  Keep this section in the header. Removing it removes the Vuffi look from every vuffi- section.
{% endcomment %}
<script>
  document.documentElement.classList.add('vuffi-js');
  {%- unless section.settings.enable_motion %}
    document.documentElement.classList.add('vuffi-still');
  {%- endunless %}
</script>
{{ 'vuffi-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vuffi-motion.js' | asset_url }}" defer></script>

{% style %}
  :root {
    --vuffi-white: {{ settings.color_palette.background }};
    --vuffi-ink: {{ settings.color_palette.foreground }};
    --vuffi-green: {{ settings.color_palette.color1 | default: '#00843F' }};
    --vuffi-lime: {{ settings.color_palette.color2 | default: '#8FFB09' }};
    --vuffi-paper: {{ settings.color_palette.color3 | default: '#F4F6F5' }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Vuffi site styles",
  "class": "vuffi-site-styles-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Loads the Vuffi look on every page. Keep this section in the header. Colors come from Theme settings > Colors: Background is white, Foreground is ink, Color 1 is the button green, Color 2 is lime and Color 3 is the paper gray."
    },
    {
      "type": "checkbox",
      "id": "enable_motion",
      "label": "Animate content as it scrolls into view",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Vuffi site styles"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
