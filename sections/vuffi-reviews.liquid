{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
  assign review_product = product | default: section.settings.product

  # Count the reviews Judge.me has for this product (standard reviews metafield, then Judge.me's own data)
  assign review_count = 0
  if review_product != blank
    assign review_count = review_product.metafields.reviews.rating_count.value | default: 0
    if review_count == 0
      assign review_count = review_product.metafields.judgeme.review_widget_data.value.number_of_reviews | default: 0
    endif
  endif

  assign show_section = true
  if section.settings.hide_when_empty and review_count == 0
    assign show_section = false
  endif
-%}
{%- if show_section or request.design_mode -%}
  {%- render 'vuffi-section-style', section: section -%}

  {%- comment -%}
    Reviews from Judge.me, with Judge.me's own Review Widget code. The Judge.me app embed
    (Theme settings > App embeds) loads the widget into the box below. App blocks from any
    reviews app can be added to this section as well.
  {%- endcomment -%}
  <section class="vuffi-section vuffi-reviews color-custom-{{ section.id }}" data-tone="{{ tone }}" id="reviews">
    <div class="vuffi-wrap">
      {%- if show_section == false -%}
        <p class="vuffi-reviews__editor-note">{{ section.settings.empty_note }}</p>
      {%- endif -%}

      <div class="vuffi-intro">
        <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="vuffi-lede">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="vuffi-reviews__body">
        {%- if section.settings.show_judgeme and review_product != blank -%}
          {%- liquid
            assign has_legacy = false
            if review_product.metafields.judgeme.widget.size > 20
              assign has_legacy = true
            endif
          -%}
          <div
            id="judgeme_product_reviews"
            class="jdgm-widget jdgm-review-widget"
            data-product-title="{{ review_product.title | escape }}"
            data-id="{{ review_product.id }}"
            data-product-id="{{ review_product.id }}"
            data-widget="review"
            data-auto-install="false"
            data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
            data-entry-point="review_widget.js"
            data-entry-key="review-widget/main.js"
          >
            {%- if has_legacy -%}
              <div class="jdgm-legacy-widget-content" style="display: none;">{{ review_product.metafields.judgeme.widget }}</div>
            {%- endif -%}
          </div>
          {%- if review_product.metafields.judgeme.review_widget_data -%}
            <script>
              window.jdgm = window.jdgm || {};
              jdgm.data ||= {};
              jdgm.data.reviewWidget ||= {};
              jdgm.data.reviewWidget[{{ review_product.id }}] = {{ review_product.metafields.judgeme.review_widget_data }};
            </script>
          {%- endif -%}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="vuffi-reviews__app">{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .vuffi-reviews__body {
    max-width: 1040px;
    margin: 0 auto;
    padding-top: 8px;
    border-top: 1px solid var(--vuffi-line);
  }

  /* Bring the Judge.me widget into the Vuffi look: our type, thin rules, round buttons */
  .vuffi-reviews .jdgm-widget,
  .vuffi-reviews .jdgm-review-widget,
  .vuffi-reviews .jdgm-outside-widget,
  .vuffi-reviews .jdgm-rev-widg {
    font-family: var(--font-body--family);
    color: inherit;
  }

  .vuffi-reviews .jdgm-rev-widg__title {
    display: none;
  }

  .vuffi-reviews .jdgm-rev-widg {
    padding: 24px 0 0 !important;
    border: 0 !important;
  }

  .vuffi-reviews .jdgm-star {
    color: var(--vuffi-accent) !important;
  }

  .vuffi-reviews .jdgm-write-rev-link,
  .vuffi-reviews .jdgm-ask-question-btn {
    border-radius: var(--vuffi-radius-btn) !important;
    background: var(--color-primary-button-background) !important;
    border-color: var(--color-primary-button-background) !important;
    color: var(--color-primary-button-text) !important;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
  }

  .vuffi-reviews .jdgm-rev {
    border-top-color: var(--vuffi-line) !important;
  }

  .vuffi-reviews__app + .vuffi-reviews__app {
    margin-top: 32px;
  }

  /* Only in the theme editor, when the section is hidden from the store */
  .vuffi-reviews__editor-note {
    margin: 0 auto 32px;
    max-width: 560px;
    padding: 12px 16px;
    border: 1px dashed var(--vuffi-line-strong);
    border-radius: var(--vuffi-radius-ui);
    font-size: 14px;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi reviews",
  "tag": "div",
  "class": "vuffi-reviews-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows Judge.me reviews for the product on this page. Turn on Judge.me in Theme settings > App embeds. Only real customer reviews."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "What owners <em>notice.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Reviews from people who bought Vuffi for their own dog.</p>"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide until the first review",
      "default": true,
      "info": "The section stays off the store until the product has a review. You still see it here in the editor."
    },
    {
      "type": "text",
      "id": "empty_note",
      "label": "Editor note while hidden",
      "default": "Hidden on the store until the first review arrives."
    },
    {
      "type": "checkbox",
      "id": "show_judgeme",
      "label": "Show the Judge.me review widget",
      "default": true
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Only used on pages that are not a product page."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Vuffi reviews"
    }
  ]
}
{% endschema %}
