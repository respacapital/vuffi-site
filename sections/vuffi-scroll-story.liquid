{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
  assign chew_1 = section.settings.chew_1
  assign chew_2 = section.settings.chew_2 | default: chew_1
  assign chew_3 = section.settings.chew_3 | default: chew_1
  assign chew_4 = section.settings.chew_4 | default: chew_2
  assign floaters = '6,22,1.2,-18,1,0|84,14,0.7,24,0.8,0|50,14,0.5,40,0.7,1|90,52,1.1,-30,1,0|28,84,0.8,12,0.75,1|74,80,1.3,-8,0.9,0' | split: '|'
-%}
{% comment %} Floating chews: left %, top %, depth, start rotation, size, 1 = hidden on phones {% endcomment %}
{%- render 'vuffi-section-style', section: section -%}
<script src="{{ 'vuffi-story.js' | asset_url }}" defer></script>

<section
  class="vuffi-section vuffi-story color-custom-{{ section.id }}"
  data-tone="{{ tone }}"
  style="--story-len: {{ section.settings.scroll_length | divided_by: 100.0 }};"
>
  <vuffi-story class="vuffi-story__track">
    <div class="vuffi-story__sticky">
      <div class="vuffi-story__floaters" aria-hidden="true">
        {%- for f in floaters -%}
          {%- liquid
            assign v = f | split: ','
            assign pick = forloop.index0 | modulo: 4
            case pick
              when 0
                assign img = chew_1
              when 1
                assign img = chew_2
              when 2
                assign img = chew_3
              else
                assign img = chew_4
            endcase
          -%}
          <div
            class="vuffi-story__floater{% if v[5] == '1' %} vuffi-story__floater--desktop{% endif %}"
            style="--x: {{ v[0] }}%; --y: {{ v[1] }}%; --depth: {{ v[2] }}; --r: {{ v[3] }}deg; --s: {{ v[4] }}; --k: {{ forloop.index0 }};"
          >
            {%- if img != blank -%}
              {%- render 'vuffi-image', image: img, label: 'scroll-chew', ratio: '1 / 1', sizes: '140px', contain: true, class: 'vuffi-story__layer' -%}
            {%- else -%}
              <span class="vuffi-story__chew-ph">chew</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="vuffi-wrap vuffi-story__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vuffi-eyebrow vuffi-story__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="vuffi-story__lines">
          {%- for block in section.blocks -%}
            <span class="vuffi-story__mask" {{ block.shopify_attributes }}>
              <span class="vuffi-story__line{% if block.settings.accent %} vuffi-story__line--accent{% endif %}" data-line>
                {{- block.settings.text -}}
              </span>
            </span>
          {%- endfor -%}
        </h2>
      </div>

      <div class="vuffi-story__product" aria-hidden="true">
        <div class="vuffi-story__peek">
          {%- render 'vuffi-image', image: chew_1, label: 'scroll-chew-1', ratio: '1 / 1', sizes: '160px', contain: true, class: 'vuffi-story__layer' -%}
        </div>
        <div class="vuffi-story__jar">
          {%- render 'vuffi-image',
            image: section.settings.jar_image,
            label: 'scroll-jar-open',
            ratio: '1 / 1',
            size: '2048 x 2048 PNG',
            sizes: '(min-width: 990px) 520px, 70vw',
            contain: true,
            class: 'vuffi-story__layer'
          -%}
        </div>
        <div class="vuffi-story__lid">
          {%- render 'vuffi-image',
            image: section.settings.lid_image,
            label: 'scroll-lid',
            ratio: '2 / 1',
            sizes: '(min-width: 990px) 320px, 45vw',
            contain: true,
            class: 'vuffi-story__layer'
          -%}
        </div>
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="vuffi-story__cta">
          {%- render 'vuffi-button', label: section.settings.button_label, url: section.settings.button_link -%}
        </div>
      {%- endif -%}
    </div>
  </vuffi-story>
</section>

{% stylesheet %}
  .vuffi-story {
    --p: 0;
    --jy: 1;
    --lid: 0;
    --peek: 0;
    --unit: min(72vw, 46svh, 520px);
    --rest: -14%;
    --lid-x: 40%;
    --lid-y: -80%;
    padding: 0;
    overflow: visible;
  }

  .vuffi-story__track {
    display: block;
    position: relative;
    height: calc(var(--story-len, 3.8) * 100svh);
  }

  .vuffi-story__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .vuffi-story__head {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 18px;
    padding-top: max(88px, 12svh);
    text-align: center;
  }

  .vuffi-story__lines {
    display: grid;
    justify-items: center;
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: clamp(48px, 14vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .vuffi-story__mask {
    display: block;
    overflow: hidden;
    padding: 0.04em 0.06em 0.06em;
  }

  .vuffi-story__line {
    display: block;
    text-wrap: balance;
  }

  .vuffi-story__line em {
    font-style: normal;
    color: var(--vuffi-accent);
  }

  .vuffi-story__line--accent {
    font-style: normal;
    color: var(--vuffi-accent);
  }

  .vuffi-story.is-live .vuffi-story__line {
    transform: translateY(calc((1 - var(--r, 0)) * 110%));
    opacity: calc(0.2 + var(--r, 0) * 0.8);
    will-change: transform;
  }

  .vuffi-story__product {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 0;
    width: var(--unit);
    aspect-ratio: 1;
    transform: translate(-50%, calc(var(--jy) * 86% + var(--rest)));
    will-change: transform;
  }

  .vuffi-story__jar {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* Sized and placed for the lid photo (2:1) sitting on the open jar photo, so the chews stay hidden until it pops */
  .vuffi-story__lid {
    position: absolute;
    z-index: 3;
    left: 7.75%;
    right: 7.75%;
    top: -5.9%;
    transform:
      translate(calc(var(--lid) * var(--lid-x)), calc(var(--lid) * var(--lid-y)))
      rotate(calc(var(--lid) * 18deg));
  }

  .vuffi-story__peek {
    position: absolute;
    z-index: 1;
    left: 36%;
    width: 28%;
    top: 4%;
    transform: translateY(calc((1 - var(--peek)) * 70% - var(--peek) * 46%)) rotate(calc(var(--peek) * -14deg));
  }

  .vuffi-story__layer.vuffi-media {
    background: transparent;
    border-radius: 0;
  }

  .vuffi-story__jar .vuffi-media {
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35));
  }

  .vuffi-story__product .vuffi-ph {
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.06);
  }

  .vuffi-story__peek .vuffi-ph,
  .vuffi-story__lid .vuffi-ph {
    padding: 4px;
    border-radius: var(--vuffi-radius);
  }

  .vuffi-story__peek .vuffi-ph__label,
  .vuffi-story__lid .vuffi-ph__label {
    font-size: 8px;
    letter-spacing: 0.04em;
  }

  .vuffi-story__floaters {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .vuffi-story__floater {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(clamp(56px, 13vw, 130px) * var(--s));
    transform:
      translate(-50%, calc((0.5 - var(--p)) * var(--depth) * 34svh))
      rotate(calc(var(--r) + var(--p) * var(--depth) * 60deg));
    opacity: calc(0.35 + var(--depth) * 0.5);
    filter: blur(calc((1.3 - var(--depth)) * 2px)) drop-shadow(0 16px 20px rgb(0 0 0 / 0.25));
  }

  .vuffi-story__floater--desktop {
    display: none;
  }

  .vuffi-story__chew-ph {
    display: grid;
    place-items: center;
    aspect-ratio: 1.15;
    border-radius: 34% 38% 36% 32%;
    background: linear-gradient(160deg, #8a5a33, #5b3519);
    color: rgb(255 255 255 / 0.6);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .vuffi-story__cta {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: max(24px, 4svh);
    transform: translate(-50%, 24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--vuffi-ease), transform 0.6s var(--vuffi-ease);
  }

  .vuffi-story.is-final .vuffi-story__cta,
  .vuffi-story.is-static .vuffi-story__cta {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  /* Without the pinned animation: the finished scene */
  .vuffi-story.is-static .vuffi-story__track {
    height: auto;
  }

  .vuffi-story.is-static .vuffi-story__sticky {
    position: relative;
    height: auto;
    min-height: 760px;
    padding-bottom: calc(var(--unit) * 0.9);
  }

  @media screen and (min-width: 750px) {
    .vuffi-story__floater--desktop {
      display: block;
    }
  }

  @media screen and (min-width: 990px) {
    /* Computers: lines on the left, the jar on the right */
    .vuffi-story {
      --unit: min(40vw, 62svh, 600px);
      --rest: -8%;
      --lid-x: 46%;
      --lid-y: -62%;
      --side: max(var(--vuffi-gutter), calc((100% - var(--vuffi-max)) / 2 + var(--vuffi-gutter)));
    }

    .vuffi-story .vuffi-story__head {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 3;
      width: 56%;
      max-width: none;
      margin: 0;
      padding: 0 0 0 var(--side);
      align-content: center;
      justify-items: start;
      text-align: left;
    }

    .vuffi-story__lines {
      justify-items: start;
      font-size: min(clamp(56px, 8.4vw, 128px), 12svh);
    }

    .vuffi-story__product {
      left: 74%;
    }

    .vuffi-story__cta {
      left: var(--side);
      bottom: max(48px, 9svh);
      transform: translate(0, 24px);
    }

    .vuffi-story.is-final .vuffi-story__cta,
    .vuffi-story.is-static .vuffi-story__cta {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi scroll story",
  "tag": "div",
  "class": "vuffi-story-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Pins to the screen while people scroll: the lines slide up one by one, the jar rises from the bottom, the lid pops and a chew peeks out, with chews floating around. People who ask their device for less motion see the finished scene."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "Inside every jar"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button at the end",
      "default": "Shop the chews"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll length",
      "min": 250,
      "max": 600,
      "step": 25,
      "unit": "%",
      "default": 375,
      "info": "How long the scene stays pinned, as a share of the screen height."
    },
    {
      "type": "header",
      "content": "Product layers",
      "info": "Transparent PNGs from the same camera angle and light."
    },
    {
      "type": "image_picker",
      "id": "jar_image",
      "label": "Open jar, no lid",
      "info": "Square transparent PNG with chews heaped at the top."
    },
    {
      "type": "image_picker",
      "id": "lid_image",
      "label": "Lid",
      "info": "Transparent PNG, 2:1, the lid alone at the same angle as the jar. It sits on the open jar and covers the chews until it pops off."
    },
    {
      "type": "image_picker",
      "id": "chew_1",
      "label": "Chew 1",
      "info": "Also the chew that peeks out of the jar."
    },
    {
      "type": "image_picker",
      "id": "chew_2",
      "label": "Chew 2"
    },
    {
      "type": "image_picker",
      "id": "chew_3",
      "label": "Chew 3"
    },
    {
      "type": "image_picker",
      "id": "chew_4",
      "label": "Chew 4"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0E3B2C"
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "5 joint actives"
        },
        {
          "type": "checkbox",
          "id": "accent",
          "label": "Lime line",
          "default": false,
          "info": "Use on the last line."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi scroll story",
      "blocks": [
        { "type": "line", "settings": { "text": "5 joint actives" } },
        { "type": "line", "settings": { "text": "30 soft chews" } },
        { "type": "line", "settings": { "text": "0 pills to hide" } },
        { "type": "line", "settings": { "text": "Every step, supported.", "accent": true } }
      ]
    }
  ]
}
{% endschema %}
