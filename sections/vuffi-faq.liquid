{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-faq color-custom-{{ section.id }}" data-tone="{{ tone }}" id="faq">
  <div class="vuffi-wrap">
    <div class="vuffi-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vuffi-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
    </div>

    <div class="vuffi-faq__list">
      {%- for block in section.blocks -%}
        <details class="vuffi-acc vuffi-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="vuffi-acc__sign" aria-hidden="true"></span>
          </summary>
          <div class="vuffi-acc__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.text != blank or section.settings.button_label != blank -%}
      <div class="vuffi-faq__more">
        {%- if section.settings.text != blank -%}
          <div class="vuffi-faq__more-text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- render 'vuffi-button', label: section.settings.button_label, url: section.settings.button_link -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% stylesheet %}
  /* One centered column of rounded question cards */
  .vuffi-faq__list {
    display: grid;
    gap: 12px;
    max-width: 840px;
    margin: 0 auto;
  }

  .vuffi-faq .vuffi-faq__item {
    border: 1px solid var(--vuffi-line);
    border-radius: var(--vuffi-radius-lg);
    background: #ffffff;
    color: var(--vuffi-ink);
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .vuffi-faq .vuffi-faq__item:last-child {
    border-bottom: 1px solid var(--vuffi-line);
  }

  .vuffi-faq .vuffi-faq__item[open] {
    border-color: color-mix(in srgb, var(--vuffi-green) 35%, transparent);
    box-shadow: 0 18px 40px rgb(11 20 16 / 0.07);
  }

  .vuffi-faq .vuffi-faq__item summary {
    padding: 22px 22px 22px 26px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .vuffi-faq .vuffi-acc__sign {
    width: 36px;
    height: 36px;
    border-color: rgb(11 20 16 / 0.18);
  }

  .vuffi-faq .vuffi-faq__item[open] .vuffi-acc__sign {
    background: var(--vuffi-green);
    border-color: var(--vuffi-green);
    color: #ffffff;
  }

  .vuffi-faq .vuffi-acc__body {
    padding: 0 26px 24px;
    max-width: 66ch;
    font-size: 16px;
    line-height: 1.65;
    color: rgb(11 20 16 / 0.72);
  }

  .vuffi-faq .vuffi-acc__body p {
    margin: 0;
  }

  .vuffi-faq .vuffi-acc__body p + p {
    margin-top: 10px;
  }

  .vuffi-faq__more {
    display: grid;
    justify-items: center;
    gap: 18px;
    margin-top: 44px;
    text-align: center;
  }

  .vuffi-faq__more-text {
    font-size: 17px;
    color: var(--color-foreground-muted);
  }

  .vuffi-faq__more-text p {
    margin: 0;
  }

  /* On dark backgrounds the cards turn into soft glass instead of white */
  [data-tone='dark'] .vuffi-faq__item {
    border-color: var(--vuffi-line);
    background: rgb(255 255 255 / 0.05);
    color: inherit;
  }

  [data-tone='dark'] .vuffi-faq__item .vuffi-acc__body {
    color: var(--color-foreground-muted);
  }

  [data-tone='dark'] .vuffi-faq__item .vuffi-acc__sign {
    border-color: var(--vuffi-line-strong);
  }

  [data-tone='dark'] .vuffi-faq__item[open] .vuffi-acc__sign {
    background: var(--vuffi-lime);
    border-color: var(--vuffi-lime);
    color: var(--vuffi-ink);
  }

  @media screen and (min-width: 750px) {
    .vuffi-faq .vuffi-faq__item summary {
      padding: 26px 26px 26px 32px;
    }

    .vuffi-faq .vuffi-acc__body {
      padding: 0 32px 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi FAQ",
  "tag": "div",
  "class": "vuffi-faq-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "Questions"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Good <em>questions.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text under the questions",
      "default": "<p>Still wondering about something? Email us and a real person will get back to you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "schema_markup",
      "label": "Add FAQ data for Google",
      "default": true,
      "info": "Use on one page only, usually the FAQ page."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long until I see a difference?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Many owners see easier mornings within a few weeks. Joint support builds with daily use, which is why we give you 90 days to decide.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi FAQ",
      "blocks": [
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
