{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}
{%- render 'contrast-override', background_color: section.settings.background_color, section_id: section.id -%}

<div
  class="vuffi-section vuffi-bar color-custom-{{ section.id }}"
  data-tone="{{ tone }}"
  {% unless request.design_mode %}
    data-hide-when-done
  {% endunless %}
>
  {%- if has_link -%}
    <a class="vuffi-bar__inner" href="{{ section.settings.link }}">
  {%- else -%}
    <div class="vuffi-bar__inner">
  {%- endif -%}
  <span class="vuffi-bar__text">
    <span class="vuffi-bar__dot" aria-hidden="true"></span>
    <span class="vuffi-bar__desktop">{{ section.settings.text }}</span>
    <span class="vuffi-bar__mobile">{{ section.settings.mobile_text | default: section.settings.text }}</span>
  </span>
  {%- if section.settings.show_countdown and section.settings.countdown_end != blank -%}
    <span class="vuffi-bar__count">
      <span class="vuffi-bar__ends">{{ section.settings.countdown_label }}</span>
      {%- render 'vuffi-countdown', end: section.settings.countdown_end, label: section.settings.countdown_label -%}
    </span>
  {%- endif -%}
  {%- if has_link and section.settings.link_label != blank -%}
    <span class="vuffi-bar__link">
      {{- section.settings.link_label -}}
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  {%- endif -%}
  {%- if has_link -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .vuffi-bar {
    padding: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
  }

  .vuffi-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 18px;
    min-height: 40px;
    padding: 8px var(--vuffi-gutter);
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  .vuffi-bar__text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .vuffi-bar__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--vuffi-accent);
    flex: none;
  }

  .vuffi-bar__desktop {
    display: none;
  }

  .vuffi-bar__count {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .vuffi-bar__ends {
    opacity: 0.7;
  }

  .vuffi-bar .vuffi-count {
    gap: 4px;
    color: var(--vuffi-accent);
    font-weight: 600;
  }

  .vuffi-bar .vuffi-count__label {
    color: var(--color-foreground);
  }

  .vuffi-bar__link {
    display: none;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .vuffi-bar__link svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s var(--vuffi-ease);
  }

  .vuffi-bar__inner:hover .vuffi-bar__link svg {
    transform: translateX(3px);
  }

  @media screen and (min-width: 750px) {
    .vuffi-bar__desktop {
      display: inline;
    }

    .vuffi-bar__mobile {
      display: none;
    }

    .vuffi-bar__link {
      display: inline-flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi sale bar",
  "class": "vuffi-bar-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Message on computers",
      "default": "Black Friday: 25% off your first subscription box"
    },
    {
      "type": "text",
      "id": "mobile_text",
      "label": "Message on phones",
      "default": "Black Friday: 25% off"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Shop now"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true,
      "info": "The bar hides itself when the countdown reaches zero."
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown text",
      "default": "Ends in"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Sale ends",
      "default": "2026-11-30T23:59:00-05:00",
      "info": "Year-month-day, then T, the time in 24 hour format, and -05:00 for Eastern time."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B1410"
    }
  ],
  "presets": [
    {
      "name": "Vuffi sale bar"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
