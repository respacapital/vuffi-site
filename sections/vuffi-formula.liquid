{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-formula color-custom-{{ section.id }}" data-tone="{{ tone }}" id="formula">
  <div class="vuffi-wrap">
    <div class="vuffi-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vuffi-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.diagram != blank -%}
      <figure class="vuffi-formula__diagram">
        {%- render 'vuffi-image',
          image: section.settings.diagram,
          label: 'diagram-chew-cross',
          ratio: '1 / 1',
          sizes: '(min-width: 750px) 560px, 92vw',
          alt: section.settings.diagram_alt,
          class: 'vuffi-melt'
        -%}
        <ul class="vuffi-formula__labels" role="list" aria-hidden="true">
          {%- for block in section.blocks -%}
            <li
              class="vuffi-formula__label vuffi-formula__label--{{ block.settings.label_side }}"
              style="--x: {{ block.settings.label_x }}%; --y: {{ block.settings.label_y }}%;"
            >
              {{- block.settings.name -}}
            </li>
          {%- endfor -%}
        </ul>
      </figure>
    {%- endif -%}
  </div>

  {%- if section.settings.show_cards and section.blocks.size > 0 -%}
    {%- comment -%} An endless row: three copies of the cards drift left by one copy, then start over without a jump. Swipe or drag to move it. {%- endcomment -%}
    <script src="{{ 'vuffi-marquee.js' | asset_url }}" defer></script>
    <vuffi-marquee
      class="vuffi-formula__loop"
      data-seconds="{{ section.blocks.size | times: section.settings.speed }}"
      data-copies="3"
      data-preload
    >
      <ul class="vuffi-formula__track" role="list" data-track>
        {%- for copy in (1..3) -%}
          {%- for block in section.blocks -%}
            <li
              class="vuffi-formula__card"
              data-card="{{ block.id }}"
              {% if copy == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true" data-copy{% endif %}
            >
              <button
                type="button"
                class="vuffi-formula__open"
                data-open="{{ block.id }}"
                aria-haspopup="dialog"
                aria-label="{{ section.settings.open_label | escape }} {{ block.settings.name | escape }}"
                {% if copy != 1 %}tabindex="-1"{% endif %}
              >
                <span class="vuffi-formula__plus" aria-hidden="true">{%- render 'vuffi-icon', name: 'plus' -%}</span>
              </button>
              {%- render 'vuffi-image',
                image: block.settings.image,
                label: block.settings.slot,
                ratio: '1 / 1',
                size: '2048 x 2048',
                sizes: '(min-width: 990px) 360px, 300px',
                widths: '300, 360, 540, 720, 900, 1200',
                class: 'vuffi-formula__media'
              -%}
              <div class="vuffi-formula__body">
                {%- if block.settings.tagline != blank -%}
                  <p class="vuffi-formula__tag">{{ block.settings.tagline }}</p>
                {%- endif -%}
                <h3 class="vuffi-formula__name">{{ block.settings.name }}</h3>
                {%- if block.settings.text != blank -%}
                  <div class="vuffi-formula__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </vuffi-marquee>

    {%- comment -%} One shared window that shows the tapped ingredient bigger {%- endcomment -%}
    <script src="{{ 'vuffi-formula.js' | asset_url }}" defer></script>
    <vuffi-formula-zoom>
      <dialog class="vuffi-formula__zoom" aria-labelledby="FormulaZoomTitle-{{ section.id }}">
        <div class="vuffi-formula__zoom-panel">
          <button type="button" class="vuffi-formula__zoom-close" data-close aria-label="{{ section.settings.close_label | escape }}">
            {%- render 'vuffi-icon', name: 'cross' -%}
          </button>
          <div class="vuffi-formula__zoom-media" data-zoom-media></div>
          <div class="vuffi-formula__zoom-body" data-zoom-body data-title-id="FormulaZoomTitle-{{ section.id }}"></div>
        </div>
      </dialog>
    </vuffi-formula-zoom>
  {%- endif -%}

  {%- if section.settings.note != blank -%}
    <div class="vuffi-wrap">
      <p class="vuffi-small vuffi-formula__note">{{ section.settings.note }}</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* The cut chew photo is square with room around it; pull the empty top and bottom in */
  .vuffi-formula__diagram {
    --d: min(100vw - var(--vuffi-gutter) * 2, 560px);
    position: relative;
    width: var(--d);
    margin: calc(var(--d) * -0.12) auto calc(var(--d) * -0.12 + 40px);
  }

  .vuffi-formula__diagram .vuffi-media {
    background: transparent;
  }

  .vuffi-formula__labels {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each name sits on the end of a leader line in the cut chew image */
  .vuffi-formula__label {
    position: absolute;
    top: var(--y);
    padding: 6px 12px;
    border-radius: var(--vuffi-radius-btn);
    background: var(--vuffi-green);
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgb(11 20 16 / 0.16);
    transform: translateY(calc(-100% - 6px));
  }

  .vuffi-formula__label--left {
    left: var(--x);
  }

  .vuffi-formula__label--right {
    right: calc(100% - var(--x));
  }

  /* The endless row of ingredient cards: moved by vuffi-marquee.js. Sideways swipes move the row,
     up and down swipes scroll the page. The soft edges are drawn on top instead of masking the row,
     so phones only move one finished layer. */
  .vuffi-formula__loop {
    position: relative;
    display: block;
    border-block: 1px solid var(--vuffi-line);
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
  }

  .vuffi-formula__loop.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .vuffi-formula__loop::before,
  .vuffi-formula__loop::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: 4%;
    pointer-events: none;
  }

  .vuffi-formula__loop::before {
    left: 0;
    background: linear-gradient(90deg, var(--color-background), color-mix(in srgb, var(--color-background) 0%, transparent));
  }

  .vuffi-formula__loop::after {
    right: 0;
    background: linear-gradient(270deg, var(--color-background), color-mix(in srgb, var(--color-background) 0%, transparent));
  }

  .vuffi-formula__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }

  .vuffi-formula__track img {
    -webkit-user-drag: none;
    user-select: none;
  }

  /* The whole card opens the ingredient bigger; a small + in the photo corner hints at it */
  .vuffi-formula__card {
    position: relative;
  }

  .vuffi-formula__open {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .vuffi-formula__open:focus-visible {
    outline: 2px solid var(--vuffi-accent);
    outline-offset: -4px;
  }

  .vuffi-formula__plus {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--vuffi-ink);
    box-shadow: 0 6px 16px rgb(11 20 17 / 0.14);
    transition: transform 0.25s var(--vuffi-ease), background-color 0.25s;
  }

  .vuffi-formula__plus .vuffi-icon {
    width: 18px;
    height: 18px;
  }

  .vuffi-formula__open:hover .vuffi-formula__plus {
    transform: scale(1.08);
    background: var(--vuffi-lime);
  }

  .vuffi-formula__loop.is-dragging .vuffi-formula__open {
    cursor: grabbing;
  }

  /* The bigger view */
  .vuffi-formula__zoom {
    width: min(560px, calc(100vw - 24px));
    max-height: calc(100svh - 24px);
    padding: 0;
    border: 0;
    border-radius: calc(var(--vuffi-radius-ui, 18px) + 6px);
    background: var(--vuffi-white, #ffffff);
    color: var(--vuffi-ink, #0b1411);
    overflow: auto;
    box-shadow: 0 40px 120px rgb(11 20 17 / 0.35);
  }

  .vuffi-formula__zoom::backdrop {
    background: rgb(11 20 17 / 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .vuffi-formula__zoom[open] {
    animation: vuffi-zoom-in 0.3s var(--vuffi-ease) both;
  }

  @keyframes vuffi-zoom-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  .vuffi-formula__zoom-panel {
    position: relative;
  }

  .vuffi-formula__zoom-close {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--vuffi-ink, #0b1411);
    cursor: pointer;
  }

  .vuffi-formula__zoom-close .vuffi-icon {
    width: 20px;
    height: 20px;
  }

  .vuffi-formula__zoom-media .vuffi-media,
  .vuffi-formula__zoom-media .vuffi-ph {
    border-radius: 0;
  }

  .vuffi-formula__zoom-body {
    display: grid;
    gap: 10px;
    padding: 24px 24px 28px;
    --color-foreground: var(--vuffi-ink, #0b1411);
    --color-foreground-muted: rgb(11 20 17 / 0.66);
  }

  .vuffi-formula__zoom-body .vuffi-formula__name {
    font-size: clamp(28px, 6vw, 36px);
  }

  .vuffi-formula__zoom-body .vuffi-formula__text {
    font-size: 16px;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    .vuffi-formula__zoom-body {
      padding: 28px 36px 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-formula__zoom[open] {
      animation: none;
    }
  }

  /* Each ingredient: a flush photo, then its words below, columns split by hairlines like a lab index */
  .vuffi-formula__card {
    display: grid;
    grid-template-rows: auto 1fr;
    flex: none;
    width: 300px;
    border-right: 1px solid var(--vuffi-line);
  }

  .vuffi-formula__card .vuffi-media,
  .vuffi-formula__card .vuffi-ph {
    border-radius: 0;
  }

  .vuffi-formula__body {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px 24px 8px;
  }

  .vuffi-formula__tag {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--vuffi-accent);
  }

  .vuffi-formula__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .vuffi-formula__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-formula__text p {
    margin: 0;
  }

  .vuffi-formula .vuffi-formula__note {
    margin: 32px auto 0;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .vuffi-formula__diagram {
      margin-bottom: calc(var(--d) * -0.12 + 56px);
    }

    .vuffi-formula__label {
      padding: 7px 14px;
      font-size: 13px;
    }

    .vuffi-formula__card {
      width: 360px;
    }

    .vuffi-formula__name {
      font-size: 28px;
    }

    .vuffi-formula__body {
      padding: 26px 30px 8px;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi formula",
  "tag": "div",
  "class": "vuffi-formula-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Five clinical actives. <em>One</em> soft chew."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each pork flavored chew combines the joint ingredients vets reach for most, so your dog gets the full stack in a treat they actually want.</p>"
    },
    {
      "type": "image_picker",
      "id": "diagram",
      "label": "Cut chew diagram",
      "info": "Optional. Square image of a chew cut in half with a leader line for each ingredient. Each ingredient's name sits on its line; set where in the ingredient blocks."
    },
    {
      "type": "text",
      "id": "diagram_alt",
      "label": "Diagram description for screen readers",
      "default": "A Vuffi soft chew cut in half, with all five ingredients labeled inside"
    },
    {
      "type": "checkbox",
      "id": "show_cards",
      "label": "Show the moving ingredient card row",
      "default": true,
      "info": "Turn off on pages that already list each ingredient in full."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Card row speed (seconds per card)",
      "min": 4,
      "max": 16,
      "step": 1,
      "unit": "s",
      "default": 9,
      "info": "Higher is slower. The row never stops; a swipe nudges it and a tap on a card opens that ingredient bigger."
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "Card button name for screen readers",
      "default": "See more about"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button name for screen readers",
      "default": "Close"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print below",
      "default": "Contains shellfish (green lipped mussel). For dogs over 12 weeks old."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "2048 x 2048, shown square"
        },
        {
          "type": "text",
          "id": "slot",
          "label": "Placeholder label",
          "default": "ing-glucosamine",
          "info": "Shown on the empty box until a photo is added."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Glucosamine"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "What it does",
          "default": "Rebuilds cartilage"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Raw material for the cushion on the ends of the bones.</p>"
        },
        {
          "type": "header",
          "content": "Name on the cut chew diagram"
        },
        {
          "type": "range",
          "id": "label_x",
          "label": "Line end across",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 3
        },
        {
          "type": "range",
          "id": "label_y",
          "label": "Line end down",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 18
        },
        {
          "type": "select",
          "id": "label_side",
          "label": "Line points to the",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi formula",
      "blocks": [
        { "type": "ingredient", "settings": { "slot": "ing-glucosamine", "label_x": 3, "label_y": 18, "label_side": "left", "name": "Glucosamine", "tagline": "Rebuilds cartilage", "text": "<p>Raw material for the cushion on the ends of the bones, so getting up and taking stairs feel easier.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-chondroitin", "label_x": 97, "label_y": 18, "label_side": "right", "name": "Chondroitin", "tagline": "Keeps it springy", "text": "<p>Holds water in cartilage to absorb every landing, and slows the wear.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-msm", "label_x": 2, "label_y": 53, "label_side": "left", "name": "MSM", "tagline": "Calms swelling", "text": "<p>Natural sulfur for cartilage, tendons and ligaments. Less soreness after play and long naps.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-hyaluronic", "label_x": 98, "label_y": 54, "label_side": "right", "name": "Hyaluronic acid", "tagline": "Keeps joints gliding", "text": "<p>The main part of joint fluid, so knees and hips bend with less grinding.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-mussel", "label_x": 16, "label_y": 82, "label_side": "left", "name": "Green lipped mussel", "tagline": "Cools inflammation", "text": "<p>Omega rich New Zealand shellfish that turns down inflammation inside the joint.</p>" } }
      ]
    }
  ]
}
{% endschema %}
