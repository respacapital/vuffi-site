{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-formula color-custom-{{ section.id }}" data-tone="{{ tone }}" id="formula">
  <div class="vuffi-wrap">
    <div class="vuffi-formula__top{% if section.settings.diagram != blank %} vuffi-formula__top--diagram{% endif %}">
      <div class="vuffi-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vuffi-eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="vuffi-h2" data-reveal style="--i: 1">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede" data-reveal style="--i: 2">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.diagram != blank -%}
        <figure class="vuffi-formula__diagram" data-reveal="scale" style="--i: 3">
          {%- render 'vuffi-image',
            image: section.settings.diagram,
            label: 'diagram-chew-cross',
            ratio: '1 / 1',
            sizes: '(min-width: 990px) 40vw, 92vw',
            alt: section.settings.diagram_alt,
            class: 'vuffi-melt'
          -%}
          <ul class="vuffi-formula__labels" role="list" aria-hidden="true">
            {%- for block in section.blocks -%}
              <li
                class="vuffi-formula__label vuffi-formula__label--{{ block.settings.label_side }}"
                style="--x: {{ block.settings.label_x }}%; --y: {{ block.settings.label_y }}%;"
              >
                {{- block.settings.name -}}
              </li>
            {%- endfor -%}
          </ul>
        </figure>
      {%- endif -%}
    </div>

    {%- if section.settings.show_cards -%}
    <ul class="vuffi-formula__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="vuffi-formula__card" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- render 'vuffi-image',
            image: block.settings.image,
            label: block.settings.slot,
            ratio: '4 / 5',
            size: '2048 x 2048',
            sizes: '(min-width: 990px) 20vw, (min-width: 750px) 40vw, 72vw',
            class: 'vuffi-formula__media'
          -%}
          <div class="vuffi-formula__body">
            <h3 class="vuffi-h3 vuffi-formula__name">{{ block.settings.name }}</h3>
            {%- if block.settings.tagline != blank -%}
              <p class="vuffi-formula__tag">{{ block.settings.tagline }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="vuffi-formula__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="vuffi-small vuffi-formula__note" data-reveal>{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .vuffi-formula__top {
    display: grid;
    gap: 20px;
    margin-bottom: 48px;
  }

  .vuffi-formula__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 74%;
    gap: 14px;
    margin: 0 calc(var(--vuffi-gutter) * -1);
    padding: 0 var(--vuffi-gutter) 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--vuffi-gutter);
    scrollbar-width: none;
  }

  .vuffi-formula__grid::-webkit-scrollbar {
    display: none;
  }

  .vuffi-formula__card {
    display: grid;
    align-content: start;
    gap: 18px;
    scroll-snap-align: start;
  }

  .vuffi-formula__media {
    transition: transform 0.8s var(--vuffi-ease);
  }

  .vuffi-formula__card:hover .vuffi-formula__media {
    transform: translateY(-6px);
  }

  .vuffi-formula__body {
    display: grid;
    gap: 8px;
  }

  .vuffi-formula__tag {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .vuffi-formula__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-formula__text p {
    margin: 0;
  }

  .vuffi-formula__note {
    margin: 32px 0 0;
  }

  .vuffi-formula__diagram {
    position: relative;
    margin: 8px 0 0;
  }

  .vuffi-formula__diagram .vuffi-media {
    background: transparent;
  }

  .vuffi-formula__labels {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each name sits on the end of a leader line in the cut chew image */
  .vuffi-formula__label {
    position: absolute;
    top: var(--y);
    padding: 5px 10px;
    border: 1px solid var(--vuffi-line);
    border-radius: var(--vuffi-radius-btn);
    background: #ffffff;
    color: var(--vuffi-ink);
    font-family: var(--font-accent--family);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgb(11 20 16 / 0.08);
    transform: translateY(calc(-100% - 6px));
  }

  .vuffi-formula__label--left {
    left: var(--x);
  }

  .vuffi-formula__label--right {
    right: calc(100% - var(--x));
  }

  @media screen and (min-width: 750px) {
    .vuffi-formula__grid {
      grid-auto-columns: 40%;
      gap: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    .vuffi-formula__top {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      gap: 64px;
      margin-bottom: 64px;
    }

    .vuffi-formula__top--diagram {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'head figure' 'lede figure';
      grid-template-rows: 1fr 1fr;
      align-items: center;
      row-gap: 24px;
    }

    .vuffi-formula__top--diagram > .vuffi-head {
      grid-area: head;
      align-self: end;
    }

    .vuffi-formula__top--diagram > .vuffi-lede {
      grid-area: lede;
      align-self: start;
    }

    .vuffi-formula__diagram {
      grid-area: figure;
      margin: 0;
    }

    .vuffi-formula__label {
      padding: 6px 10px;
      font-size: 12px;
    }

    /* The five photos stretch across the whole screen, nearly edge to edge */
    .vuffi-formula__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr));
      gap: 12px;
      margin: 0 calc(var(--vuffi-edge) * -1 + 12px);
      padding: 0;
      overflow: visible;
    }

    .vuffi-formula__body {
      padding-inline: 4px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi formula",
  "tag": "div",
  "class": "vuffi-formula-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "The formula"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Five clinical actives. <em>One</em> soft chew."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each pork flavored chew combines the joint ingredients vets reach for most, so your dog gets the full stack in a treat they actually want.</p>"
    },
    {
      "type": "image_picker",
      "id": "diagram",
      "label": "Cut chew diagram",
      "info": "Optional. Square image of a chew cut in half with a leader line for each ingredient. Each ingredient's name sits on its line; set where in the ingredient blocks."
    },
    {
      "type": "text",
      "id": "diagram_alt",
      "label": "Diagram description for screen readers",
      "default": "A Vuffi soft chew cut in half, with all five ingredients labeled inside"
    },
    {
      "type": "checkbox",
      "id": "show_cards",
      "label": "Show the ingredient photo row",
      "default": true,
      "info": "Turn off on pages that already list each ingredient in full."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print below",
      "default": "Contains shellfish (green lipped mussel). For dogs over 12 weeks old."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "2048 x 2048, shown at 4:5"
        },
        {
          "type": "text",
          "id": "slot",
          "label": "Placeholder label",
          "default": "ing-glucosamine",
          "info": "Shown on the empty box until a photo is added."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Glucosamine"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "What it does",
          "default": "Rebuilds cartilage"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Raw material for the cushion on the ends of the bones.</p>"
        },
        {
          "type": "header",
          "content": "Name on the cut chew diagram"
        },
        {
          "type": "range",
          "id": "label_x",
          "label": "Line end across",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 3
        },
        {
          "type": "range",
          "id": "label_y",
          "label": "Line end down",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 18
        },
        {
          "type": "select",
          "id": "label_side",
          "label": "Line points to the",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi formula",
      "blocks": [
        { "type": "ingredient", "settings": { "slot": "ing-glucosamine", "label_x": 3, "label_y": 18, "label_side": "left", "name": "Glucosamine", "tagline": "Rebuilds cartilage", "text": "<p>Raw material for the cushion on the ends of the bones, so getting up and taking stairs feel easier.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-chondroitin", "label_x": 97, "label_y": 18, "label_side": "right", "name": "Chondroitin", "tagline": "Keeps it springy", "text": "<p>Holds water in cartilage to absorb every landing, and slows the wear.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-msm", "label_x": 2, "label_y": 53, "label_side": "left", "name": "MSM", "tagline": "Calms swelling", "text": "<p>Natural sulfur for cartilage, tendons and ligaments. Less soreness after play and long naps.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-hyaluronic", "label_x": 98, "label_y": 54, "label_side": "right", "name": "Hyaluronic acid", "tagline": "Keeps joints gliding", "text": "<p>The main part of joint fluid, so knees and hips bend with less grinding.</p>" } },
        { "type": "ingredient", "settings": { "slot": "ing-mussel", "label_x": 16, "label_y": 82, "label_side": "left", "name": "Green lipped mussel", "tagline": "Cools inflammation", "text": "<p>Omega rich New Zealand shellfish that turns down inflammation inside the joint.</p>" } }
      ]
    }
  ]
}
{% endschema %}
