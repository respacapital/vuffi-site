{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
  assign heading = section.settings.heading | default: page.title
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-phero color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap">
    <div class="vuffi-head{% if section.settings.center %} vuffi-head--center{% endif %} vuffi-phero__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vuffi-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="vuffi-display vuffi-phero__title">{{ heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.show_photo -%}
      <div class="vuffi-phero__photo">
        {%- render 'vuffi-image',
          image: section.settings.image,
          label: section.settings.slot,
          ratio: '21 / 9',
          size: '3840 x 1646 (21:9)',
          sizes: '(min-width: 750px) 100vw, 190vw',
          priority: true,
          alt: section.settings.image_alt
        -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .vuffi-phero__head {
    max-width: 920px;
  }

  .vuffi-phero__title {
    font-size: clamp(44px, 7vw, 100px);
  }

  /* The title photo runs the full width of the screen */
  .vuffi-phero__photo {
    margin: 40px calc(var(--vuffi-edge) * -1) 0;
  }

  .vuffi-phero__photo .vuffi-media,
  .vuffi-phero__photo .vuffi-ph {
    border-radius: 0;
  }

  /* Taller crop on phones so the photo still reads */
  @media screen and (max-width: 749px) {
    .vuffi-phero__photo .vuffi-media,
    .vuffi-phero__photo .vuffi-ph {
      --ratio: 4 / 5 !important;
    }
  }

  @media screen and (min-width: 990px) {
    .vuffi-phero__photo {
      margin-top: 64px;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi page title",
  "tag": "div",
  "class": "vuffi-phero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Center the text",
      "default": false
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "checkbox",
      "id": "show_photo",
      "label": "Show a wide photo under the text",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "3840 x 1646 (21:9). Cropped to 4:5 on phones, so keep the subject in the middle and set the focal point."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description for screen readers"
    },
    {
      "type": "text",
      "id": "slot",
      "label": "Placeholder label",
      "default": "page-hero"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Vuffi page title"
    }
  ]
}
{% endschema %}
