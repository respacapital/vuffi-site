{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}
{%- if section.settings.show_particles -%}
  <script src="{{ 'vuffi-particles.js' | asset_url }}" defer></script>
{%- endif -%}

<section class="vuffi-section vuffi-hero color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-hero__bg" aria-hidden="true">
    <div class="vuffi-hero__glow vuffi-hero__glow--a"></div>
    <div class="vuffi-hero__glow vuffi-hero__glow--b"></div>
    {%- if section.settings.show_particles -%}
      <vuffi-particles
        class="vuffi-hero__particles"
        data-count="{{ section.settings.particle_count }}"
        data-colors="{{ settings.color_palette.color2 | default: '#8FFB09' }},#FFFFFF"
      ></vuffi-particles>
    {%- endif -%}
  </div>

  <div class="vuffi-wrap vuffi-hero__grid">
    <div class="vuffi-hero__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vuffi-eyebrow vuffi-hero__in" style="--d: 0">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="vuffi-display vuffi-hero__title vuffi-hero__in" style="--d: 1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede vuffi-hero__in" style="--d: 2">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="vuffi-hero__stage">
      <div class="vuffi-hero__halo" aria-hidden="true"></div>
      <div class="vuffi-hero__float">
        {%- render 'vuffi-image',
          image: section.settings.jar_image,
          label: 'hero-jar',
          ratio: '1 / 1',
          size: '2048 x 2048 transparent PNG',
          sizes: '(min-width: 990px) 540px, 78vw',
          priority: true,
          contain: true,
          class: 'vuffi-hero__jar'
        -%}
      </div>
      <div class="vuffi-hero__shadow" aria-hidden="true"></div>

      {%- if section.settings.show_cards -%}
        {%- if section.settings.card1_value != blank -%}
          <div class="vuffi-hero__card vuffi-hero__card--1" style="--d: 5">
            <span class="vuffi-hero__card-value">{{ section.settings.card1_value }}</span>
            <span class="vuffi-hero__card-label">{{ section.settings.card1_label }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.card2_value != blank -%}
          <div class="vuffi-hero__card vuffi-hero__card--2" style="--d: 6">
            <span class="vuffi-hero__card-value">{{ section.settings.card2_value }}</span>
            <span class="vuffi-hero__card-label">{{ section.settings.card2_label }}</span>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="vuffi-hero__cta">
      <div class="vuffi-actions vuffi-hero__in" style="--d: 3">
        {%- if section.settings.button_label != blank -%}
          {%- render 'vuffi-button', label: section.settings.button_label, url: section.settings.button_link -%}
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          {%- render 'vuffi-button',
            label: section.settings.button2_label,
            url: section.settings.button2_link,
            style: 'ghost',
            arrow: false
          -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_countdown and section.settings.countdown_end != blank -%}
        <div class="vuffi-hero__deal vuffi-hero__in" style="--d: 4" data-hide-when-done>
          {%- if section.settings.badge_text != blank -%}
            <span class="vuffi-hero__badge">{{ section.settings.badge_text }}</span>
          {%- endif -%}
          <span class="vuffi-hero__ends">
            <span>{{ section.settings.countdown_label }}</span>
            {%- render 'vuffi-countdown',
              end: section.settings.countdown_end,
              label: section.settings.countdown_label,
              class: 'vuffi-hero__count'
            -%}
          </span>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="vuffi-hero__trust vuffi-hero__in" style="--d: 5" role="list">
          {%- for block in section.blocks -%}
            <li class="vuffi-hero__trust-item" {{ block.shopify_attributes }}>
              {%- render 'vuffi-icon', name: block.settings.icon -%}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .vuffi-hero {
    --hero-top: calc(var(--header-height, 64px) * var(--transparent-header-offset-boolean, 0));
    isolation: isolate;
    padding-block: calc(var(--vuffi-pt, 32px) + var(--hero-top)) var(--vuffi-pb, 56px);
    overflow: hidden;
  }

  .vuffi-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 70% at 50% 0%, color-mix(in srgb, var(--vuffi-green) 26%, transparent) 0%, transparent 60%),
      linear-gradient(180deg, var(--color-background) 0%, color-mix(in srgb, var(--color-background) 82%, var(--vuffi-green)) 100%);
  }

  .vuffi-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
  }

  .vuffi-hero__glow--a {
    left: 50%;
    top: 42%;
    width: min(120vw, 760px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--vuffi-green) 70%, transparent) 0%, transparent 62%);
    opacity: 0.75;
  }

  .vuffi-hero__glow--b {
    left: -20%;
    bottom: -30%;
    width: 70vw;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--vuffi-lime) 22%, transparent) 0%, transparent 65%);
  }

  .vuffi-hero__particles {
    position: absolute;
    inset: 0;
    display: block;
  }

  .vuffi-hero__particles canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .vuffi-hero__grid {
    display: grid;
    grid-template-areas: 'head' 'stage' 'cta';
    gap: 8px;
  }

  .vuffi-hero__head {
    grid-area: head;
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .vuffi-hero__title {
    max-width: 11ch;
    font-size: clamp(44px, 12.5vw, 112px);
  }

  .vuffi-hero .vuffi-lede {
    max-width: 40ch;
    font-size: 16px;
  }

  .vuffi-hero__stage {
    grid-area: stage;
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 340px);
    margin: 4px auto 0;
  }

  .vuffi-hero__halo {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--vuffi-lime) 30%, transparent);
    box-shadow:
      0 0 80px color-mix(in srgb, var(--vuffi-lime) 18%, transparent),
      inset 0 0 60px color-mix(in srgb, var(--vuffi-lime) 10%, transparent);
    animation: vuffi-hero-halo 7s ease-in-out infinite;
  }

  .vuffi-hero__float {
    position: relative;
    z-index: 1;
    width: 100%;
    animation: vuffi-hero-float 7s ease-in-out infinite;
  }

  .vuffi-hero__jar.vuffi-media {
    background: transparent;
    border-radius: 0;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.45));
  }

  .vuffi-hero__jar.vuffi-ph {
    border-color: rgb(255 255 255 / 0.3);
    border-radius: 32px;
    background: rgb(255 255 255 / 0.04);
  }

  .vuffi-hero__shadow {
    width: 52%;
    height: 18px;
    margin-top: -6px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.55), transparent 70%);
    animation: vuffi-hero-shadow 7s ease-in-out infinite;
  }

  .vuffi-hero__card {
    position: absolute;
    z-index: 2;
    display: none;
    gap: 2px;
    padding: 14px 18px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 18px;
    background: rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    color: #ffffff;
    animation: vuffi-hero-rise 1s var(--vuffi-ease) both;
    animation-delay: calc(var(--d, 0) * 90ms + 300ms);
  }

  .vuffi-hero__card-value {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 30px;
    line-height: 1;
    color: var(--vuffi-lime);
  }

  .vuffi-hero__card-label {
    font-size: 13px;
    font-weight: 500;
    opacity: 0.8;
  }

  .vuffi-hero__cta {
    grid-area: cta;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .vuffi-hero__cta .vuffi-actions {
    display: grid;
    width: 100%;
    max-width: 420px;
  }

  .vuffi-hero__cta .vuffi-btn {
    width: 100%;
  }

  .vuffi-hero__deal {
    display: grid;
    justify-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .vuffi-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 11px;
    border: 1px solid color-mix(in srgb, var(--vuffi-lime) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--vuffi-lime) 10%, transparent);
    color: var(--vuffi-lime);
    font-size: 13px;
    font-weight: 600;
  }

  .vuffi-hero__badge::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vuffi-lime);
    animation: vuffi-hero-pulse 2.2s infinite;
  }

  .vuffi-hero__ends {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--color-foreground-muted);
  }

  .vuffi-hero__count {
    color: var(--color-foreground);
    font-weight: 700;
    font-size: 16px;
  }

  .vuffi-hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
    margin: 4px 0 0;
    padding: 16px 0 0;
    list-style: none;
    border-top: 1px solid var(--vuffi-line);
  }

  .vuffi-hero__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
  }

  .vuffi-hero__trust-item .vuffi-icon {
    width: 20px;
    height: 20px;
  }

  .vuffi-hero__in {
    animation: vuffi-hero-rise 1s var(--vuffi-ease) both;
    animation-delay: calc(var(--d, 0) * 90ms);
  }

  @keyframes vuffi-hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }

  @keyframes vuffi-hero-float {
    0%,
    100% {
      transform: translateY(0) rotate(-1.5deg);
    }
    50% {
      transform: translateY(-16px) rotate(1.5deg);
    }
  }

  @keyframes vuffi-hero-shadow {
    0%,
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
    50% {
      transform: scaleX(0.82);
      opacity: 0.6;
    }
  }

  @keyframes vuffi-hero-halo {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.04);
      opacity: 1;
    }
  }

  @keyframes vuffi-hero-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(143 251 9 / 0.6);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px rgb(143 251 9 / 0);
    }
  }

  @media screen and (min-width: 750px) {
    .vuffi-hero__stage {
      width: min(100%, 420px);
    }

    .vuffi-hero .vuffi-lede {
      font-size: 18px;
    }

    .vuffi-hero__cta .vuffi-actions {
      display: flex;
      justify-content: center;
      max-width: none;
    }

    .vuffi-hero__cta .vuffi-btn {
      width: auto;
    }

    .vuffi-hero__deal {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (min-width: 990px) {
    .vuffi-hero {
      display: grid;
      align-items: center;
      min-height: min(100svh, 940px);
      padding-block: calc(var(--vuffi-pt, 48px) + var(--hero-top)) var(--vuffi-pb, 64px);
    }

    .vuffi-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'head stage' 'cta stage';
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: 48px;
      row-gap: 32px;
    }

    .vuffi-hero__head,
    .vuffi-hero__cta {
      justify-items: start;
      text-align: left;
    }

    .vuffi-hero__head {
      align-self: end;
      gap: 22px;
    }

    .vuffi-hero__title {
      font-size: clamp(64px, 6.6vw, 112px);
    }

    .vuffi-hero__cta .vuffi-actions,
    .vuffi-hero__deal,
    .vuffi-hero__trust {
      justify-content: flex-start;
    }

    .vuffi-hero__stage {
      align-self: center;
      width: min(100%, 560px);
      margin: 0 auto;
    }

    .vuffi-hero__glow--a {
      left: 74%;
      top: 50%;
      width: 900px;
    }

    .vuffi-hero__card {
      display: grid;
    }

    .vuffi-hero__card--1 {
      left: -6%;
      top: 18%;
    }

    .vuffi-hero__card--2 {
      right: -6%;
      bottom: 16%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-hero__in,
    .vuffi-hero__card,
    .vuffi-hero__float,
    .vuffi-hero__shadow,
    .vuffi-hero__halo,
    .vuffi-hero__badge::before {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi hero",
  "tag": "div",
  "class": "vuffi-hero-section",
  "limit": 1,
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Jar and background"
    },
    {
      "type": "image_picker",
      "id": "jar_image",
      "label": "Floating jar",
      "info": "Transparent PNG of the closed jar, 2048 x 2048, a little space around it."
    },
    {
      "type": "checkbox",
      "id": "show_particles",
      "label": "Show drifting particles",
      "default": true
    },
    {
      "type": "range",
      "id": "particle_count",
      "label": "Particles",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 70,
      "info": "Phones show about half as many."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B1410",
      "info": "The green glow is added on top from the theme colors."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the headline",
      "default": "Vet recommended joint support"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Every step, <em>supported.</em>",
      "info": "Put a word in italics to make it lime."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Five clinical joint ingredients in one daily soft chew, for hips, knees and elbows at every age.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop Black Friday"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button",
      "default": "See what's inside"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Sale and countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show the sale and countdown",
      "default": true,
      "info": "Hides itself when the countdown reaches zero."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Sale badge",
      "default": "Black Friday: 25% off your first box"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown text",
      "default": "Ends in"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Sale ends",
      "default": "2026-11-30T23:59:00-05:00",
      "info": "Year-month-day, then T, the time in 24 hour format, and -05:00 for Eastern time."
    },
    {
      "type": "header",
      "content": "Glass cards beside the jar (computers)"
    },
    {
      "type": "checkbox",
      "id": "show_cards",
      "label": "Show glass cards",
      "default": true
    },
    {
      "type": "text",
      "id": "card1_value",
      "label": "Card 1 big text",
      "default": "5 in 1"
    },
    {
      "type": "text",
      "id": "card1_label",
      "label": "Card 1 small text",
      "default": "joint actives per chew"
    },
    {
      "type": "text",
      "id": "card2_value",
      "label": "Card 2 big text",
      "default": "90 days"
    },
    {
      "type": "text",
      "id": "card2_label",
      "label": "Card 2 small text",
      "default": "money back guarantee"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "vet", "label": "Stethoscope" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "refresh", "label": "Cancel anytime" },
            { "value": "paw", "label": "Paw" },
            { "value": "chew", "label": "Soft chew" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "vet"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Vet recommended"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi hero",
      "blocks": [
        { "type": "trust", "settings": { "icon": "vet", "text": "Vet recommended" } },
        { "type": "trust", "settings": { "icon": "shield", "text": "90 day guarantee" } },
        { "type": "trust", "settings": { "icon": "truck", "text": "Free shipping" } }
      ]
    }
  ]
}
{% endschema %}
