{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

{%- comment -%}
  The jar, explained: one large photo of the real jar that melts into the dark background,
  and a list beside it of what each part of the label means.
{%- endcomment -%}
<section class="vuffi-section vuffi-jarx{% if section.settings.glow and tone == 'dark' %} vuffi-glow{% endif %} color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap vuffi-jarx__grid">
    <figure class="vuffi-jarx__photo vuffi-bleed vuffi-bleed--left">
      {%- liquid
        assign jar_ratio = '1 / 1'
        if section.settings.image != blank
          assign jar_ratio = section.settings.image.width | append: ' / ' | append: section.settings.image.height
        endif
      -%}
      {%- render 'vuffi-image',
        image: section.settings.image,
        label: 'label-jar',
        ratio: jar_ratio,
        size: '1600 x 2000',
        sizes: '(min-width: 990px) 50vw, 100vw',
        alt: section.settings.image_alt,
        class: 'vuffi-melt'
      -%}
    </figure>

    <div class="vuffi-jarx__copy">
      <h2 class="vuffi-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="vuffi-lede">{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="vuffi-jarx__list" role="list">
        {%- for block in section.blocks -%}
          <li class="vuffi-jarx__item" {{ block.shopify_attributes }}>
            <h3 class="vuffi-jarx__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="vuffi-jarx__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .vuffi-jarx__grid {
    display: grid;
    gap: 8px;
  }

  .vuffi-jarx .vuffi-jarx__photo {
    margin: calc(var(--vuffi-pt, 120px) * -0.35) calc(var(--vuffi-gutter) * -1) 0;
  }

  .vuffi-jarx__photo .vuffi-media {
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 78%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 78%, transparent 100%);
  }

  .vuffi-jarx__copy {
    display: grid;
    align-content: start;
    gap: 18px;
  }

  .vuffi-jarx__list {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--vuffi-line);
  }

  .vuffi-jarx__item {
    display: grid;
    gap: 6px;
    padding: 20px 0 22px;
    border-bottom: 1px solid var(--vuffi-line);
  }

  .vuffi-jarx__title {
    margin: 0;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
  }

  .vuffi-jarx__text {
    margin: 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  @media screen and (min-width: 990px) {
    .vuffi-jarx__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 72px;
      align-items: center;
    }

    .vuffi-jarx .vuffi-jarx__photo {
      margin: calc(var(--vuffi-pt, 120px) * -1) 0 calc(var(--vuffi-pb, 120px) * -1) calc(var(--vuffi-edge) * -1);
    }

    .vuffi-jarx__photo .vuffi-media,
    .vuffi-jarx__photo .vuffi-ph {
      border-radius: 0;
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 72%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 12%, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(90deg, #000 0%, #000 72%, transparent 100%), linear-gradient(180deg, transparent 0%, #000 12%, #000 82%, transparent 100%);
      mask-composite: intersect;
    }

    .vuffi-jarx__title {
      font-size: 19px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi jar explained",
  "tag": "div",
  "class": "vuffi-label-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "The jar, <em>explained.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Everything printed on the label, and what it means for your dog.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Jar photo",
      "info": "A photo of the jar on a dark background (square or portrait). Its edges fade into the section."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Jar description for screen readers",
      "default": "A jar of Vuffi Advanced Hip and Joint Support on a stone plinth with two soft chews"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B1411"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Soft natural light on dark backgrounds",
      "default": true,
      "info": "A faint warm light from the top corner, like the hero photo. It never moves."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Label point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Small and medium breeds"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "What it means"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vuffi jar explained",
      "blocks": [
        { "type": "point", "settings": { "title": "Small and medium breeds" } },
        { "type": "point", "settings": { "title": "Veterinarian recommended" } },
        { "type": "point", "settings": { "title": "Protect and Support" } }
      ]
    }
  ]
}
{% endschema %}
