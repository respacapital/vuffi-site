{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
-%}
{%- render 'vuffi-section-style', section: section -%}

<footer class="vuffi-section vuffi-foot color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap">
    <div class="vuffi-foot__top">
      <div class="vuffi-foot__signup">
        <h2 class="vuffi-h3 vuffi-foot__title">{{ section.settings.signup_heading }}</h2>
        {%- if section.settings.signup_text != blank -%}
          <p class="vuffi-foot__text">{{ section.settings.signup_text }}</p>
        {%- endif -%}
        {%- form 'customer', id: 'VuffiFooterSignup', class: 'vuffi-foot__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, footer">
          <label class="vuffi-visually-hidden" for="VuffiFooterEmail">{{ section.settings.email_label }}</label>
          <input
            id="VuffiFooterEmail"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ section.settings.email_label | escape }}"
          >
          <button type="submit" class="vuffi-btn vuffi-btn--primary">{{ section.settings.signup_button }}</button>
          {%- if form.posted_successfully? -%}
            <p class="vuffi-foot__note" role="status">{{ section.settings.signup_success }}</p>
          {%- elsif form.errors -%}
            <p class="vuffi-foot__note" role="alert">{{ form.errors.messages['email'] | default: section.settings.signup_error }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <nav class="vuffi-foot__menus" aria-label="{{ section.settings.nav_label | escape }}">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign menu = section.settings.menu_1
                assign title = section.settings.menu_1_title
              when 2
                assign menu = section.settings.menu_2
                assign title = section.settings.menu_2_title
              else
                assign menu = section.settings.menu_3
                assign title = section.settings.menu_3_title
            endcase
          -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            <div class="vuffi-foot__menu">
              <h3 class="vuffi-foot__menu-title">{{ title | default: menu.title }}</h3>
              <ul role="list">
                {%- for link in menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    <div class="vuffi-foot__mid">
      {%- liquid
        assign socials = 'instagram,tiktok,facebook,youtube' | split: ','
      -%}
      <ul class="vuffi-foot__social" role="list">
        {%- for name in socials -%}
          {%- assign key = 'social_' | append: name -%}
          {%- assign url = section.settings[key] -%}
          {%- if url != blank -%}
            <li>
              <a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ name | capitalize }}">
                {%- case name -%}
                  {%- when 'instagram' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
                  {%- when 'tiktok' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3-3.46M14 3c.4 2.6 2.2 4.4 5 4.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  {%- when 'facebook' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 8H16V4.5h-2.3C11.2 4.5 10 6 10 8.4V10H8v3.4h2V20h3.5v-6.6h2.3l.4-3.4h-2.7V8.8c0-.6.3-.8 1-.8Z" fill="currentColor"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor"/></svg>
                {%- endcase -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_payment_icons -%}
        <ul class="vuffi-foot__pay" role="list" aria-label="{{ section.settings.payment_label | escape }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'vuffi-foot__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="vuffi-foot__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    <div class="vuffi-foot__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</span>
    </div>
  </div>

  <div
    class="vuffi-foot__lockup"
    data-reveal="fade"
    style="--logo-ink: {{ section.settings.logo_strength }}%; --logo-paw: {{ section.settings.paw_strength }}%;"
  >
    <div class="vuffi-wrap">
      <div class="vuffi-foot__mark">
        {%- render 'vuffi-logo', class: 'vuffi-foot__logo' -%}
      </div>
      {%- if section.settings.slogan != blank -%}
        <p class="vuffi-foot__slogan">{{ section.settings.slogan }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .vuffi-foot {
    padding-block: var(--vuffi-pt, 88px) 0;
    font-size: 15px;
  }

  .vuffi-foot a {
    color: inherit;
    text-decoration: none;
  }

  .vuffi-foot__top {
    display: grid;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--vuffi-line);
  }

  .vuffi-foot__signup {
    display: grid;
    gap: 14px;
    max-width: 520px;
  }

  .vuffi-foot__text {
    margin: 0;
    color: var(--color-foreground-muted);
  }

  .vuffi-foot__form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .vuffi-foot__form input[type='email'] {
    flex: 1 1 220px;
    min-height: 54px;
    padding: 0 22px;
    border: 1px solid var(--vuffi-line-strong);
    border-radius: var(--vuffi-radius-sm);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .vuffi-foot__form input[type='email']::placeholder {
    color: var(--color-foreground-muted);
  }

  .vuffi-foot__form input[type='email']:focus-visible {
    outline: 2px solid var(--vuffi-accent);
    outline-offset: 2px;
  }

  .vuffi-foot__note {
    flex-basis: 100%;
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--vuffi-accent);
  }

  .vuffi-foot__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .vuffi-foot__menu-title {
    margin: 0 0 14px;
    font-family: var(--font-subheading--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .vuffi-foot__menu ul,
  .vuffi-foot__social,
  .vuffi-foot__pay,
  .vuffi-foot__legal ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vuffi-foot__menu li + li {
    margin-top: 10px;
  }

  .vuffi-foot__menu a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.4s var(--vuffi-ease);
  }

  .vuffi-foot__menu a:hover {
    background-size: 100% 1px;
  }

  .vuffi-foot__mid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 28px;
  }

  .vuffi-foot__social {
    display: flex;
    gap: 10px;
  }

  .vuffi-foot__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--vuffi-line);
    border-radius: var(--vuffi-radius-sm);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .vuffi-foot__social a:hover {
    background: var(--vuffi-accent);
    border-color: var(--vuffi-accent);
    color: var(--vuffi-ink);
  }

  .vuffi-foot__social svg {
    width: 20px;
    height: 20px;
  }

  .vuffi-foot__pay {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vuffi-foot__pay-icon {
    width: 38px;
    height: 24px;
  }

  .vuffi-foot__disclaimer {
    margin: 0;
    padding: 20px 0;
    border-top: 1px solid var(--vuffi-line);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .vuffi-foot__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 20px 0 8px;
    font-size: 13px;
    color: var(--color-foreground-muted);
  }

  .vuffi-foot__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .vuffi-foot__legal a:hover {
    color: var(--color-foreground);
  }

  .vuffi-foot__lockup {
    padding: 40px 0 28px;
    overflow: hidden;
  }

  .vuffi-foot__mark {
    overflow: hidden;
  }

  .vuffi-foot__logo {
    display: block;
    width: 100%;
    height: auto;
    color: color-mix(in srgb, var(--color-foreground) var(--logo-ink, 14%), transparent);
    --vuffi-logo-paw: color-mix(in srgb, var(--vuffi-accent) var(--logo-paw, 60%), transparent);
    transform: translateY(18%);
    transition: transform 1.4s var(--vuffi-ease);
  }

  .vuffi-foot__lockup.is-in .vuffi-foot__logo,
  html.vuffi-still .vuffi-foot__logo,
  html:not(.vuffi-js) .vuffi-foot__logo {
    transform: none;
  }

  .vuffi-foot__slogan {
    margin: 18px 0 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.035em;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.1;
    text-align: right;
    color: var(--vuffi-accent);
  }

  @media screen and (min-width: 750px) {
    .vuffi-foot__menus {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .vuffi-foot__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 96px;
    }

    .vuffi-foot__lockup {
      padding-top: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-foot__logo {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi footer",
  "tag": "div",
  "class": "vuffi-foot-section",
  "settings": [
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Email heading",
      "default": "Joint tips, launches and member only offers."
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "Email text",
      "default": "One short email a week. Unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Email button",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "signup_success",
      "label": "Thank you message",
      "default": "You're in. Watch your inbox."
    },
    {
      "type": "text",
      "id": "signup_error",
      "label": "Error message",
      "default": "Please check your email address."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Menu area name for screen readers",
      "default": "Footer"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 heading",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Menu 3 heading",
      "default": "Company"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Payment icons name for screen readers",
      "default": "Payment methods"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Supplement disclaimer",
      "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease. Consult your veterinarian before starting any supplement."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright name",
      "default": "Vuffi. A Respa Capital brand."
    },
    {
      "type": "range",
      "id": "logo_strength",
      "label": "Big logo letters strength",
      "min": 4,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 14,
      "info": "Lower is lighter and quieter."
    },
    {
      "type": "range",
      "id": "paw_strength",
      "label": "Big logo paw strength",
      "min": 4,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 60
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan beside the big logo",
      "default": "Every step, supported."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0E3B2C"
    }
  ],
  "presets": [
    {
      "name": "Vuffi footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
