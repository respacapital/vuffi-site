{%- liquid
  capture tone
    render 'vuffi-tone', color: section.settings.background_color
  endcapture
  assign tone = tone | strip
  assign ring = section.settings.seal_text | append: ' · ' | append: section.settings.seal_text | append: ' · '
-%}
{%- render 'vuffi-section-style', section: section -%}

<section class="vuffi-section vuffi-guarantee color-custom-{{ section.id }}" data-tone="{{ tone }}">
  <div class="vuffi-wrap vuffi-guarantee__grid">
    <div class="vuffi-guarantee__seal" data-reveal="scale" aria-hidden="true">
      <svg class="vuffi-guarantee__ring" viewBox="0 0 300 300">
        <defs>
          <path id="SealPath-{{ section.id }}" d="M150 150 m-118 0 a118 118 0 1 1 236 0 a118 118 0 1 1 -236 0"/>
        </defs>
        <circle cx="150" cy="150" r="146" class="vuffi-guarantee__disc"/>
        <circle cx="150" cy="150" r="96" class="vuffi-guarantee__inner"/>
        <text class="vuffi-guarantee__text">
          <textPath href="#SealPath-{{ section.id }}" textLength="738">{{ ring | upcase }}</textPath>
        </text>
      </svg>
      <div class="vuffi-guarantee__center">
        <span class="vuffi-guarantee__days">{{ section.settings.days }}</span>
        <span class="vuffi-guarantee__unit">{{ section.settings.days_label }}</span>
      </div>
    </div>

    <div class="vuffi-guarantee__copy">
      <div class="vuffi-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vuffi-eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="vuffi-h2" data-reveal style="--i: 1">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="vuffi-lede" data-reveal style="--i: 2">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <div class="vuffi-actions" data-reveal style="--i: 3">
        {%- if section.settings.button_label != blank -%}
          {%- render 'vuffi-button', label: section.settings.button_label, url: section.settings.button_link -%}
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          {%- render 'vuffi-button', label: section.settings.link_label, url: section.settings.link, style: 'ghost', arrow: false -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .vuffi-guarantee__grid {
    display: grid;
    gap: 48px;
    justify-items: center;
    text-align: center;
  }

  .vuffi-guarantee__copy .vuffi-head {
    margin-inline: auto;
    justify-items: center;
  }

  .vuffi-guarantee__copy .vuffi-actions {
    justify-content: center;
    margin-top: 32px;
  }

  .vuffi-guarantee__seal {
    position: relative;
    width: min(76vw, 320px);
    aspect-ratio: 1;
  }

  .vuffi-guarantee__ring {
    width: 100%;
    height: 100%;
    animation: vuffi-spin 40s linear infinite;
  }

  .vuffi-guarantee__disc {
    fill: var(--vuffi-ink);
  }

  .vuffi-guarantee__inner {
    fill: none;
    stroke: var(--vuffi-lime);
    stroke-width: 1.5;
    stroke-dasharray: 2 6;
  }

  .vuffi-guarantee__text {
    fill: #ffffff;
    font-family: var(--font-body--family);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .vuffi-guarantee__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    color: #ffffff;
    text-align: center;
  }

  .vuffi-guarantee__days {
    font-family: var(--font-heading--family);
    font-size: clamp(76px, 10vw, 104px);
    line-height: 0.85;
    color: var(--vuffi-lime);
  }

  .vuffi-guarantee__unit {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @keyframes vuffi-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media screen and (min-width: 990px) {
    .vuffi-guarantee__grid {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      gap: 96px;
      text-align: left;
    }

    .vuffi-guarantee__copy .vuffi-head {
      margin-inline: 0;
      justify-items: start;
    }

    .vuffi-guarantee__copy .vuffi-actions {
      justify-content: flex-start;
    }

    .vuffi-guarantee__seal {
      width: 380px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vuffi-guarantee__ring {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vuffi guarantee",
  "tag": "div",
  "class": "vuffi-guarantee-section",
  "settings": [
    {
      "type": "text",
      "id": "days",
      "label": "Seal number",
      "default": "90"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Seal word under the number",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Text around the seal",
      "default": "Money back guarantee"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above",
      "default": "Our promise"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "default": "Feel the difference, <em>or don't pay.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Give Vuffi 90 days. If you don't see your dog moving easier, email us and we'll refund your order. No forms, no return shipping. Keep the jar.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Try it risk free"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second button",
      "default": "Read the policy"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Second button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Vuffi guarantee"
    }
  ]
}
{% endschema %}
